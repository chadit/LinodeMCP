# Anchored: pytest run from the repo root lands a report here, while the one
# the gates read is python/coverage.json (ignored in python/.gitignore).
/coverage.json
.pytest_cache/
.mypy_cache/
.ruff_cache/

# binaries from testing; anchored so the cmd/ source packages stay tracked
/go/route-dump
/go/toolgen
/go/cmd/toolgen/toolgen

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Generated protobuf code and codegen stamp (regenerated by `make proto`)
/go/internal/genpb/
/go/internal/gentools/
/go/internal/genlocal/
/python/src/linodemcp/genpb/
/python/src/linodemcp/gentools/
/python/src/linodemcp/genlocal/
/go/internal/toolschemas/data/
/.make/

# Environment
.env
.env.*
!.env.example

# Override: the global ~/.gitignore excludes /.github/ broadly, but this
# repo ships its own CI workflows. Re-include them here.
!/.github/
!/.github/**

# Override: the global ~/.gitignore excludes **/docs/ broadly, but this
# repo ships host integration examples and profile docs under docs/.
# Re-include them here.
!/docs/
!/docs/**

# Same override, same reason, for the prose a tool project ships beside its
# code: tools/techdocs-proof/docs/ is the comparator's wiki. The **/docs/ rule
# these two lines answer lives in a personal global ignore file, not here, so a
# clone on a machine without that global never needed them. They are harmless
# there and they are what keeps the wiki committable on a machine that has it.
!/tools/**/docs/
!/tools/**/docs/**

# Tool registries written from the proto contract by scripts/gen_tool_registries.py
# (also `make proto`). Ignored for the same reason the generated trees above are:
# they restate what the descriptors declare, so a hand edit would be a second
# copy of a fact rather than a decision. The contract files beside them that DO
# hold decisions (handwritten-tools.txt, every *-baseline.txt, languages.txt)
# stay committed.
#
# Below the docs re-include on purpose: that `!/docs/**` line un-ignores
# everything under docs/, and the last matching pattern wins, so these two would
# not be ignored at all if they sat above it.
/docs/contracts/tools-manifest.txt
/docs/contracts/tools-capabilities.txt
