          "last_remote_addr": "203.0.113.7",
          "user_agent": "ci-agent"
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_profile_device_revoke",
        "would_execute": {
          "method": "DELETE",
          "path": "/profile/devices/123"
        },
        "current_state": {
          "id": 123,
          "created": "2024-05-01T00:01:01",
          "expiry": "2024-06-01T00:01:01",
          "last_authenticated": "2024-05-02T00:01:01",
          "last_remote_addr": "203.0.113.7",
          "user_agent": "ci-agent"
        },
        "dependencies": [],
