{
  "tool": "linode_profile_device_revoke",
  "description": "Shared non-positive device_id rejection and the single DELETE once confirmed. Missing-device_id text and confirm text diverge (see report).",
  "cases": [
    {
      "name": "rejects non-positive device_id",
      "args": {
        "device_id": 0,
        "confirm": true
      },
      "expect_error": "device_id must be a positive integer"
    },
    {
      "name": "revokes a trusted device",
      "args": {
        "device_id": 123,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "DELETE",
        "path": "/profile/devices/123"
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "device_id": 123
      },
      "expect_error": "This revokes a trusted device. Set confirm=true to proceed."
    },
    {
      "name": "dry_run_preview",
      "args": {
        "device_id": 123,
        "dry_run": true
      },
      "api_responses": {
        "GET /profile/devices/123": {
          "id": 123,
          "created": "2024-05-01T00:01:01",
          "expiry": "2024-06-01T00:01:01",
