{
  "tool": "linode_instance_shutdown",
  "description": "Pins the power action: the id rule its contract declares, the confirm gate, the POST it sends, the id echo it answers with, and the preview reading the instance whose power state would change.",
  "cases": [
    {
      "name": "rejects an instance_id below one",
      "args": {
        "instance_id": 0,
        "confirm": true
      },
      "expect_error": "instance_id must be a positive integer"
    },
    {
      "name": "requires confirm",
      "args": {
        "instance_id": 5
      },
      "expect_error": "This shuts down a Linode instance. Set confirm=true to proceed."
    },
    {
      "name": "shuts down the instance",
      "args": {
        "instance_id": 5,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/shutdown"
      }
    },
    {
      "name": "answers with the id the call named",
      "args": {
        "instance_id": 5,
        "confirm": true
      },
      "api_response": {},
      "expect_result": {
        "message": "Instance 5 shutdown initiated successfully",
        "instance_id": 5
      }
    },
    {
      "name": "dry_run_preview",
      "args": {
        "instance_id": 5,
        "dry_run": true
      },
      "api_responses": {
        "GET /linode/instances/5": {
