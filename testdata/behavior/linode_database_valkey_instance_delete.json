{
  "tool": "linode_database_valkey_instance_delete",
  "description": "Pre-validated instance-id rejection (both languages agree) and the DELETE the handler issues once bypass-confirmed. The delete declares no preview sentence, so the preview's side effects and warnings stay empty. The dry-run state body leaves engine version and replication type blank: TechDocs documents neither for Valkey. The refusal case is the single-id destroy tier's, answered inside the wrapper both languages route through rather than by an emitted call.",
  "cases": [
    {
      "name": "confirm alone is blocked by the destroy gate",
      "args": {
        "instance_id": 123,
        "confirm": true
      },
      "expect_error": "linode_database_valkey_instance_delete is destructive. Either:\n  1. Call with dry_run: true first to preview, then call again with\n     confirm: true, confirmed_dry_run: true\n  2. Call with confirm: true, confirm_bypass_dry_run: true to skip preview\n  3. Use yolo: true (only if profile allows)"
    },
    {
      "name": "rejects a non-positive instance_id",
      "args": {
        "instance_id": 0,
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "expect_error": "instance_id must be a positive integer"
    },
    {
      "name": "refuses an argument the input message does not declare",
      "args": {
        "instance_id": 123,
        "confirm": true,
        "confirm_bypass_dry_run": true,
        "bogus": 1
      },
      "expect_error": "Unsupported argument(s) for linode_database_valkey_instance_delete: bogus"
    },
    {
      "name": "deletes a valkey instance",
      "args": {
        "instance_id": 123,
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "api_response": {},
      "expect_request": {
        "method": "DELETE",
        "path": "/databases/valkey/instances/123"
      }
    },
    {
      "name": "dry_run_preview",
