{
  "tool": "linode_monitor_service_alert_definition_create",
  "description": "Alert-definition entity IDs are strings in the Linode Metrics API, unlike the integer entity IDs the token endpoint takes; these cases pin that split plus the positivity rule on channel_ids. A body that will not parse must fail rather than turn into a made-up record. The two languages frame the parse failure differently, so the shared assertion is the parser's position marker. scope is now a required body field (the API documents it as required with the single value account), so every case supplies it and it appears in the posted body.",
  "cases": [
    {
      "name": "rejects integer entity ids",
      "args": {
        "service_type": "dbaas",
        "label": "CPU high",
        "severity": 1,
        "rule_criteria": {
          "rules": [
            {
              "metric": "cpu_usage"
            }
          ]
        },
        "trigger_conditions": {
          "criteria_condition": "ALL"
        },
        "channel_ids": [
          10000
        ],
        "entity_ids": [
          12345
        ],
        "confirm": true,
        "scope": "account"
      },
      "expect_error": "entity_ids must be an array of strings"
    },
    {
      "name": "rejects non-positive channel ids",
      "args": {
        "service_type": "dbaas",
        "label": "CPU high",
        "severity": 1,
        "rule_criteria": {
          "rules": [
            {
              "metric": "cpu_usage"
            }
          ]
        },
        "trigger_conditions": {
          "criteria_condition": "ALL"
        },
        "channel_ids": [
          0
        ],
        "confirm": true,
        "scope": "account"
      },
      "expect_error": "channel_ids must be a non-empty array of positive integers"
    },
    {
      "name": "posts the create body with string entity ids",
      "args": {
        "service_type": "dbaas",
        "label": "CPU high",
        "severity": 1,
        "rule_criteria": {
          "rules": [
            {
              "metric": "cpu_usage"
            }
          ]
        },
        "trigger_conditions": {
          "criteria_condition": "ALL"
        },
        "channel_ids": [
          10000
        ],
        "description": "High CPU usage",
        "entity_ids": [
          "12345"
        ],
        "confirm": true,
        "scope": "account"
      },
      "api_response": {
        "id": 67890,
        "label": "CPU high"
      },
      "expect_request": {
        "method": "POST",
        "path": "/monitor/services/dbaas/alert-definitions",
        "body": {
          "label": "CPU high",
          "severity": 1,
          "rule_criteria": {
            "rules": [
              {
                "metric": "cpu_usage"
              }
            ]
          },
          "trigger_conditions": {
            "criteria_condition": "ALL"
          },
          "channel_ids": [
            10000
          ],
          "description": "High CPU usage",
          "entity_ids": [
            "12345"
          ],
          "scope": "account"
        }
      }
    },
