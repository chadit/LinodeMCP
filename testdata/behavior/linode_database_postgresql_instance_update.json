{
  "tool": "linode_database_postgresql_instance_update",
  "description": "Confirm-gated update PUT body. Instance-id and empty-payload error text diverge between languages (see report). The dry-run case pins the full Tier B preview from docs/dry-run.md: the PUT body, the fetched current_state (the instance exists, so the preview reads it), and the side effect plus warning the update implies. Two cluster_size cases close the 2026-09-01 techdocs drift: the resize case sends cluster_size as the only body argument, so it fails if the field is missing from require_any_of, and the out-of-set case pins the documented 1/2/3 rule.",
  "cases": [
    {
      "name": "updates a postgresql instance label",
      "args": {
        "instance_id": 123,
        "label": "renamed-pg",
        "confirm": true
      },
      "api_response": {
        "id": 123,
        "label": "renamed-pg"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/databases/postgresql/instances/123",
        "body": {
          "label": "renamed-pg"
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "instance_id": 123,
        "label": "renamed-db"
      },
      "expect_error": "This updates a PostgreSQL Managed Database instance. Set confirm=true to proceed."
    },
    {
      "name": "detaches the vpc on an explicit null private network",
      "args": {
        "instance_id": 123,
        "private_network": null,
        "confirm": true
      },
      "api_response": {
        "id": 123,
        "label": "renamed-pg"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/databases/postgresql/instances/123",
        "body": {
          "private_network": null
        }
      }
    },
    {
      "name": "zero-fills null and unknown response fields",
      "args": {
        "instance_id": 123,
        "label": "renamed-pg",
        "confirm": true
      },
      "api_response": {
        "id": null,
        "label": null,
        "future_field": "ignored"
      },
      "expect_result": {
        "message": "PostgreSQL Managed Database instance '' (ID: 0) updated",
        "database_instance": {
          "id": 0,
          "status": "",
          "label": "",
          "region": "",
          "type": "",
          "engine": "",
          "version": "",
          "cluster_size": 0,
          "replication_type": "",
          "ssl_connection": false,
          "encrypted": false,
          "allow_list": [],
          "created": "",
          "updated": ""
        }
      }
    },
    {
      "name": "rejects a bare-array API response",
      "args": {
        "instance_id": 123,
        "label": "renamed-pg",
        "confirm": true
      },
      "api_response": [],
      "expect_api_error": "Failed to update PostgreSQL Managed Database"
    },
    {
      "name": "dry run previews the update without sending it",
      "args": {
        "dry_run": true,
        "instance_id": 123,
        "label": "renamed-pg"
      },
      "api_responses": {
        "GET /databases/postgresql/instances/123": {
          "id": 123,
          "status": "active",
          "label": "prod-pg",
          "region": "us-east",
          "type": "g6-dedicated-2",
          "engine": "postgresql",
          "version": "16.4",
          "cluster_size": 3,
          "replication_type": "asynch",
          "ssl_connection": true,
          "encrypted": false,
          "allow_list": [
            "203.0.113.1/32"
          ],
          "created": "2026-01-02T03:04:05",
          "updated": "2026-01-03T04:05:06"
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_database_postgresql_instance_update",
        "would_execute": {
          "method": "PUT",
          "path": "/databases/postgresql/instances/123",
          "body": {
            "label": "renamed-pg"
          }
        },
        "current_state": {
          "id": 123,
          "status": "active",
          "label": "prod-pg",
          "region": "us-east",
          "type": "g6-dedicated-2",
          "engine": "postgresql",
          "version": "16.4",
          "cluster_size": 3,
          "replication_type": "asynch",
          "ssl_connection": true,
          "encrypted": false,
          "allow_list": [
            "203.0.113.1/32"
          ],
          "created": "2026-01-02T03:04:05",
          "updated": "2026-01-03T04:05:06"
        },
        "dependencies": [],
        "side_effects": [
          "PostgreSQL Managed Database 123 will be updated."
        ],
        "warnings": [
          "Updating a Managed Database can change service behavior."
        ]
      }
    },
    {
      "name": "resizes the cluster to three nodes",
      "args": {
        "instance_id": 123,
        "cluster_size": 3,
        "confirm": true
      },
      "api_response": {
        "id": 123,
        "label": "prod-pg",
        "cluster_size": 3
      },
      "expect_request": {
        "method": "PUT",
        "path": "/databases/postgresql/instances/123",
        "body": {
          "cluster_size": 3
        }
      }
    },
    {
      "name": "rejects a cluster size outside the documented set",
      "args": {
        "instance_id": 123,
        "cluster_size": 4,
        "confirm": true
      },
      "expect_error": "cluster_size must be one of: 1, 2, 3"
    },
    {
      "name": "refuses an argument the message does not declare",
      "args": {
        "instance_id": 123,
        "label": "renamed-pg",
        "confirm": true,
        "bogus_field": "x"
      },
      "expect_error": "Unsupported argument(s) for linode_database_postgresql_instance_update: bogus_field"
    }
  ]
}
