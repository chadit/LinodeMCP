          "updated_by": "adevi"
        },
        "dependencies": [],
        "side_effects": [
          "A reply will be posted to support ticket 123."
        ],
        "warnings": []
      }
    },
    {
      "name": "trims the reply description before sending it",
      "args": {
        "confirm": true,
        "ticket_id": 123,
        "description": "  Thanks for the help  "
      },
      "api_response": {
        "id": 900,
        "description": "Thanks for the help"
      },
      "expect_request": {
        "method": "POST",
        "path": "/support/tickets/123/replies",
        "body": {
          "description": "Thanks for the help"
        }
