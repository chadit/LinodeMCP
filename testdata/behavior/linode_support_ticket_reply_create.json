          "updated": "2026-01-02T00:00:00",
          "updated_by": "adevi"
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_support_ticket_reply_create",
        "would_execute": {
          "method": "POST",
          "path": "/support/tickets/123/replies",
          "body": {
            "description": "Thanks for the help"
          }
        },
        "current_state": {
          "attachments": [],
          "closable": true,
          "closed": null,
          "description": "My Linode is unreachable via SSH.",
          "entity": null,
          "gravatar_id": "0",
