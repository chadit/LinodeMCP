{
  "tool": "linode_iam_idp_config_excluded_user_update",
  "description": "Excluded user replace. The route answers with the resulting page rather than the resource it changed, so the tool decodes the list envelope; the empty-list case is a real request, the documented way to clear the emergency access accounts.",
  "cases": [
    {
      "name": "rejects a blank idp_config_id",
      "args": {
        "idp_config_id": "  ",
        "usernames": [
          "jsmith"
        ],
        "confirm": true
      },
      "expect_error": "idp_config_id is required"
    },
    {
      "name": "rejects a blank username entry",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "jsmith",
          "   "
        ],
        "confirm": true
      },
      "expect_error": "usernames entries must not be blank"
    },
    {
      "name": "rejects usernames that is not an array",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": "jsmith",
        "confirm": true
      },
      "expect_error": "usernames must be an array of strings"
    },
    {
      "name": "requires confirm",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "jsmith"
        ]
      },
      "expect_error": "This replaces the emergency access list for single sign-on. Set confirm=true to proceed."
    },
    {
      "name": "replaces the excluded users",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "jsmith",
          "breakglass"
        ],
        "confirm": true
      },
      "api_response": {
        "data": [
          {
            "id": "jsmith",
            "label": "jsmith",
            "type": "user",
            "url": "/v4/account/users/jsmith"
          },
          {
            "id": "breakglass",
            "label": "breakglass",
            "type": "user",
            "url": "/v4/account/users/breakglass"
          }
        ],
        "page": 1,
        "pages": 1,
        "results": 2
      },
      "expect_request": {
        "method": "PUT",
        "path": "/iam/idp-configs/b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b/users-excluded",
        "api_surface": "v4beta",
        "body": {
          "usernames": [
            "jsmith",
            "breakglass"
          ]
        }
      }
    },
    {
      "name": "sends the empty list that clears the exclusions",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [],
        "confirm": true
      },
      "api_response": {
        "data": [],
        "page": 1,
        "pages": 1,
        "results": 0
      },
      "expect_request": {
        "method": "PUT",
        "path": "/iam/idp-configs/b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b/users-excluded",
        "api_surface": "v4beta",
        "body": {
          "usernames": []
        }
      }
    },
    {
      "name": "returns the users from the page envelope",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "jsmith"
        ],
        "confirm": true
      },
      "api_response": {
        "data": [
          {
            "id": "jsmith",
            "label": "jsmith",
            "type": "user",
            "url": "/v4/account/users/jsmith"
          }
        ],
        "page": 1,
        "pages": 1,
        "results": 1
      },
      "expect_result": {
        "count": 1,
        "users": [
          {
            "id": "jsmith",
            "label": "jsmith",
            "type": "user",
            "url": "/v4/account/users/jsmith"
          }
        ]
      }
    },
    {
      "name": "rejects a bare-array API response",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "jsmith"
        ],
        "confirm": true
      },
      "api_response": [],
      "expect_api_error": "response"
    },
    {
      "name": "rejects object data in the page envelope",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "jsmith"
        ],
        "confirm": true
      },
      "api_response": {
        "data": {}
      },
      "expect_api_error": "list"
    },
    {
      "name": "rejects a string element in page data",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "jsmith"
        ],
        "confirm": true
      },
      "api_response": {
        "data": [
          "jsmith"
        ]
      },
      "expect_api_error": "element"
    },
    {
      "name": "previews the excluded user replacement",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "jsmith"
        ],
        "confirm": true,
        "dry_run": true
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_iam_idp_config_excluded_user_update",
        "would_execute": {
          "method": "PUT",
          "path": "/v4beta/iam/idp-configs/b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b/users-excluded",
          "body": {
            "usernames": [
              "jsmith"
            ]
          }
        },
        "current_state": null,
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    }
  ]
}
