{
  "tool": "linode_instance_config_create",
  "description": "Pins the shared missing-linode_id and missing-label rejections and the config-create POST body. devices/size rejection text diverges (see report). A success body that is not a JSON object must fail rather than turn into a zeroed config record; the two languages name the subject differently, so only the failure verb is shared.",
  "cases": [
    {
      "name": "rejects missing linode_id",
      "args": {},
      "expect_error": "linode_id is required"
    },
    {
      "name": "rejects missing label",
      "args": { "linode_id": 123, "confirm": true },
      "expect_error": "label is required"
    },
    {
      "name": "creates a config profile",
      "args": { "linode_id": 123, "label": "boot", "devices": { "sda": { "disk_id": 111 } }, "confirm": true },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/123/configs",
        "body": { "label": "boot", "devices": { "sda": { "disk_id": 111 } } }
      }
    },
    {
      "name": "requires confirm",
      "args": {"linode_id": 123, "label": "boot", "devices": {"sda": {"disk_id": 111}}},
      "expect_error": "This creates a configuration profile on the instance. Set confirm=true to proceed."
    },
    {
      "name": "rejects an invalid run_level (proto ConfigRunLevel enum)",
      "args": { "linode_id": 123, "label": "boot", "devices": { "sda": { "disk_id": 111 } }, "run_level": "turbo", "confirm": true },
      "expect_error": "run_level must be one of: default, single, binbash"
    },
    {
      "name": "rejects an invalid virt_mode (proto ConfigVirtMode enum)",
      "args": { "linode_id": 123, "label": "boot", "devices": { "sda": { "disk_id": 111 } }, "virt_mode": "hvm", "confirm": true },
      "expect_error": "virt_mode must be one of: paravirt, fullvirt"
    },
    {
      "name": "rejects an invalid device slot",
      "args": { "linode_id": 123, "label": "boot", "devices": { "sdz": { "disk_id": 111 } }, "confirm": true },
      "expect_error": "device slot sdz must be one of sda through sdh"
    },
    {
      "name": "rejects a null API response",
      "args": { "linode_id": 123, "label": "boot", "devices": { "sda": { "disk_id": 111 } }, "confirm": true },
      "api_response": null,
      "expect_api_error": "Failed to create"
    },
    {
      "name": "rejects a bare-array API response",
      "args": { "linode_id": 123, "label": "boot", "devices": { "sda": { "disk_id": 111 } }, "confirm": true },
      "api_response": [],
      "expect_api_error": "Failed to create"
    },
    {
      "name": "rejects a populated-array API response",
      "args": { "linode_id": 123, "label": "boot", "devices": { "sda": { "disk_id": 111 } }, "confirm": true },
      "api_response": [1, 2],
      "expect_api_error": "Failed to create"
    },
    {
      "name": "rejects a string API response",
      "args": { "linode_id": 123, "label": "boot", "devices": { "sda": { "disk_id": 111 } }, "confirm": true },
      "api_response": "not-an-object",
      "expect_api_error": "Failed to create"
    },
    {
      "name": "rejects a numeric API response",
      "args": { "linode_id": 123, "label": "boot", "devices": { "sda": { "disk_id": 111 } }, "confirm": true },
      "api_response": 7,
      "expect_api_error": "Failed to create"
    },
    {
      "name": "rejects a boolean API response",
      "args": { "linode_id": 123, "label": "boot", "devices": { "sda": { "disk_id": 111 } }, "confirm": true },
      "api_response": true,
      "expect_api_error": "Failed to create"
    }
  ]
}
