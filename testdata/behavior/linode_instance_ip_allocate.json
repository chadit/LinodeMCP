{
  "tool": "linode_instance_ip_allocate",
  "description": "Allocate needs confirm; public is required by the API (no default) so both languages reject a missing public rather than injecting one; then POSTs the type/public body. A success body that is not a JSON object must fail rather than turn into a zeroed address record. The preview reports the call without reading state: the route creates an address rather than replacing one.",
  "cases": [
    {
      "name": "rejects missing linode_id once confirmed",
      "args": {
        "confirm": true,
        "type": "ipv4"
      },
      "expect_error": "linode_id must be a positive integer"
    },
    {
      "name": "requires public once confirmed",
      "args": {
        "confirm": true,
        "linode_id": 123,
        "type": "ipv4"
      },
      "expect_error": "public is required"
    },
    {
      "name": "allocates an IP with the type/public body",
      "args": {
        "linode_id": 123,
        "type": "ipv4",
        "public": true,
        "confirm": true
      },
      "api_response": {
        "address": "203.0.113.5",
        "linode_id": 123
      },
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/123/ips",
        "body": {
          "type": "ipv4",
          "public": true
        }
      }
    },
    {
      "name": "reports the allocated address",
      "args": {
        "confirm": true,
        "linode_id": 123,
        "type": "ipv4",
        "public": true
      },
      "api_response": {
        "address": "203.0.113.5",
        "gateway": "203.0.113.1",
        "subnet_mask": "255.255.255.0",
        "prefix": 24,
        "type": "ipv4",
        "public": true,
        "rdns": "li-5.members.linode.com",
        "linode_id": 123,
        "region": "us-east"
      },
      "expect_result": {
        "message": "IP 203.0.113.5 allocated for instance 123",
        "ip": {
          "address": "203.0.113.5",
          "gateway": "203.0.113.1",
          "subnet_mask": "255.255.255.0",
          "prefix": 24,
          "type": "ipv4",
          "public": true,
          "rdns": "li-5.members.linode.com",
          "linode_id": 123,
          "region": "us-east"
        }
      }
    },
    {
      "name": "rejects an invalid type",
      "args": {
        "linode_id": 123,
        "type": "ipv6-range",
        "public": true,
        "confirm": true
      },
      "expect_error": "type must be one of: ipv4"
    },
    {
      "name": "requires confirm",
      "args": {
        "linode_id": 123,
        "type": "ipv4",
        "public": true
      },
      "expect_error": "This allocates a new IP address which may incur charges. Set confirm=true to proceed."
    },
    {
      "name": "rejects a null API response",
      "args": {
        "linode_id": 123,
        "type": "ipv4",
        "public": true,
        "confirm": true
      },
      "api_response": null,
      "expect_api_error": "Failed to allocate"
    },
    {
      "name": "rejects a bare-array API response",
      "args": {
        "linode_id": 123,
        "type": "ipv4",
        "public": true,
        "confirm": true
      },
      "api_response": [],
      "expect_api_error": "Failed to allocate"
    },
    {
      "name": "rejects a populated-array API response",
      "args": {
        "linode_id": 123,
        "type": "ipv4",
        "public": true,
        "confirm": true
      },
      "api_response": [
        1,
        2
      ],
      "expect_api_error": "Failed to allocate"
    },
    {
      "name": "rejects a string API response",
      "args": {
        "linode_id": 123,
        "type": "ipv4",
        "public": true,
        "confirm": true
      },
      "api_response": "not-an-object",
      "expect_api_error": "Failed to allocate"
    },
    {
      "name": "rejects a numeric API response",
      "args": {
        "linode_id": 123,
        "type": "ipv4",
        "public": true,
        "confirm": true
      },
      "api_response": 7,
      "expect_api_error": "Failed to allocate"
    },
    {
      "name": "rejects a boolean API response",
      "args": {
        "linode_id": 123,
        "type": "ipv4",
        "public": true,
        "confirm": true
      },
      "api_response": true,
      "expect_api_error": "Failed to allocate"
    },
    {
      "name": "carries a reserved address into the body",
      "args": {
        "linode_id": 123,
        "type": "ipv4",
        "public": true,
        "confirm": true,
        "address": "203.0.113.9"
      },
      "api_response": {
        "address": "203.0.113.9",
        "linode_id": 123
      },
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/123/ips",
        "body": {
          "type": "ipv4",
          "public": true,
          "address": "203.0.113.9"
        }
      }
    },
    {
      "name": "rejects a non-boolean public",
      "args": {
        "linode_id": 123,
        "type": "ipv4",
        "public": "yes",
        "confirm": true
      },
      "expect_error": "public must be a boolean"
    },
    {
      "name": "rejects an omitted type",
      "args": {
        "linode_id": 123,
        "public": true,
        "confirm": true
      },
      "expect_error": "type must be one of: ipv4"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "linode_id": 123,
        "type": "ipv4",
        "public": true,
        "dry_run": true
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_instance_ip_allocate",
        "would_execute": {
          "method": "POST",
          "path": "/linode/instances/123/ips",
          "body": {
            "type": "ipv4",
            "public": true
          }
        },
        "current_state": null,
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    }
  ]
}
