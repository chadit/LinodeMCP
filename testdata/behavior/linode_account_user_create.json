{
  "tool": "linode_account_user_create",
  "description": "Account user create: required-field rejections, confirm gate, and the POST body once confirmed. A successful response must be a decodable JSON object.",
  "cases": [
    {
      "name": "requires username",
      "args": { "confirm": true },
      "expect_error": "username is required"
    },
    {
      "name": "requires email",
      "args": { "username": "alice", "confirm": true },
      "expect_error": "email is required"
    },
    {
      "name": "dry_run_preview",
      "args": { "username": "alice", "email": "alice@example.com", "dry_run": true },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_account_user_create",
        "would_execute": {
          "method": "POST",
          "path": "/account/users",
          "body": { "username": "alice", "email": "alice@example.com" }
        },
        "current_state": null,
        "dependencies": [],
        "side_effects": [
          "A new account user \"alice\" will be created with restricted=false."
        ],
        "warnings": []
      }
    },
    {
      "name": "requires confirm before creating",
      "args": { "username": "alice", "email": "alice@example.com" },
      "expect_error": "This creates an account user. Set confirm=true to proceed."
    },
    {
      "name": "creates an account user",
      "args": { "username": "alice", "email": "alice@example.com", "restricted": false, "confirm": true },
      "api_response": { "username": "alice", "email": "alice@example.com", "restricted": false },
      "expect_request": {
        "method": "POST",
        "path": "/account/users",
        "body": { "username": "alice", "email": "alice@example.com", "restricted": false }
      }
    },
    {
      "name": "requires confirm",
      "args": {"username": "alice", "email": "alice@example.com", "restricted": false},
      "expect_error": "This creates an account user. Set confirm=true to proceed."
    },
    {
      "name": "rejects a non-object API response",
      "args": { "username": "alice", "email": "alice@example.com", "restricted": false, "confirm": true },
      "api_response": 7,
      "expect_api_error": "Failed to create"
    }
  ]
}
