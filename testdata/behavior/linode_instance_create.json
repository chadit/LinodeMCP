{
  "tool": "linode_instance_create",
  "description": "Pins the three shared field-required rejections and the create POST body. Both languages omit booted (API defaults true) and backups_enabled (API default) unless the caller sets them, so a minimal call sends the same body: region, type, interface_generation, and one public interface. That interface is assembled from the flat firewall_id, route_ipv4 and route_ipv6 arguments; a caller who supplies interfaces themselves gets the list sent verbatim with nothing synthesized beside it. Both route flags travel under their declared defaults, so an explicit false is sent rather than dropped. A success body that is not a JSON object must fail rather than turn into a zeroed instance record.",
  "cases": [
    {
      "name": "requires region",
      "args": {
        "confirm": true
      },
      "expect_error": "region is required"
    },
    {
      "name": "requires type",
      "args": {
        "confirm": true,
        "region": "us-east"
      },
      "expect_error": "type is required"
    },
    {
      "name": "requires firewall_id",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1"
      },
      "expect_error": "firewall_id is required for instance creation. Get a firewall ID from linode_firewall_list, or create one with linode_firewall_create."
    },
    {
      "name": "rejects a zero firewall_id",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1",
        "firewall_id": 0
      },
      "expect_error": "firewall_id is required for instance creation. Get a firewall ID from linode_firewall_list, or create one with linode_firewall_create."
    },
    {
      "name": "rejects a negative firewall_id",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1",
        "firewall_id": -1
      },
      "expect_error": "firewall_id is required for instance creation. Get a firewall ID from linode_firewall_list, or create one with linode_firewall_create."
    },
    {
      "name": "creates an instance with a public interface",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1",
        "firewall_id": 123
      },
      "api_response": {
        "id": 100,
        "label": "web",
        "region": "us-east",
        "type": "g6-nanode-1",
        "status": "provisioning"
      },
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances",
        "body": {
          "region": "us-east",
          "type": "g6-nanode-1",
          "interface_generation": "linode",
          "interfaces": [
            {
              "public": {},
              "firewall_id": 123,
              "default_route": {
                "ipv4": true,
                "ipv6": true
              }
            }
          ]
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {},
      "expect_error": "This operation creates a billable resource. Set confirm=true to proceed."
    },
    {
      "name": "rejects a numeric API response",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1",
        "firewall_id": 123
      },
      "api_response": 7,
      "expect_api_error": "Failed to create instance"
    },
    {
      "name": "rejects a boolean API response",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1",
        "firewall_id": 123
      },
      "api_response": true,
      "expect_api_error": "Failed to create instance"
    },
    {
      "name": "rejects a populated-array API response",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1",
        "firewall_id": 123
      },
      "api_response": [
        1,
        2
      ],
      "expect_api_error": "Failed to create instance"
    },
    {
      "name": "sends the tags array in the body",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1",
        "firewall_id": 123,
        "tags": [
          "prod",
          "web"
        ]
      },
      "api_response": {
        "id": 100,
        "label": "web",
        "region": "us-east",
        "type": "g6-nanode-1",
        "status": "provisioning"
      },
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances",
        "body": {
          "region": "us-east",
          "type": "g6-nanode-1",
          "tags": [
            "prod",
            "web"
          ],
          "interface_generation": "linode",
          "interfaces": [
            {
              "public": {},
              "firewall_id": 123,
              "default_route": {
                "ipv4": true,
                "ipv6": true
              }
            }
          ]
        }
      }
    },
    {
      "name": "rejects a tags value that is not an array",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1",
        "firewall_id": 123,
        "tags": 5
      },
      "expect_error": "tags must be a JSON string array"
    },
    {
      "name": "rejects a blank tag entry",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1",
        "firewall_id": 123,
