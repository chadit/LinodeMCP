        "type": "g6-nanode-1",
        "firewall_id": 123,
        "backup_id": -1
      },
      "expect_error": "backup_id must be a positive integer"
    },
    {
      "name": "rejects an unknown disk_encryption",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1",
        "firewall_id": 123,
        "disk_encryption": "maybe"
      },
      "expect_error": "disk_encryption must be one of: disabled, enabled"
    },
    {
      "name": "rejects an unknown maintenance_policy",
      "args": {
        "confirm": true,
        "region": "us-east",
        "type": "g6-nanode-1",
        "firewall_id": 123,
        "maintenance_policy": "linode/whenever"
      },
      "expect_error": "maintenance_policy must be one of: linode/migrate, linode/power_off_on"
    },
    {
