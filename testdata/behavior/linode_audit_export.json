            "tool": "linode_instance_list",
            "tool_capability": "read",
            "environment": "default",
            "profile": "full-access",
            "mode": "normal",
            "plan_id": null,
            "args": {
              "region": "us-east"
            },
            "args_redacted": [],
            "status": "success",
            "latency_ms": 12,
            "result_summary": "listed 2 instances",
            "error": null,
            "linodemcp_version": "0.1.0",
            "session_id": "sess-behavior-fixture",
            "credential_generation": 0
          },
          {
