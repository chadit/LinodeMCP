      "host_decided": [
        {
          "path": "path",
          "type": "string",
          "pattern": "^.+[/\\\\]linode-audit-export-[^/\\\\]+\\.json$",
          "reason": "the OS temp directory plus the unique suffix each language's own temp-file helper picks"
        }
      ],
      "expect_result": {
        "format": "json",
        "record_count": 3,
