{
  "tool": "linode_audit_export",
  "description": "CapMeta local export tool (no Linode API call). Pins the invalid-format rejection, and the success path for two formats. The written file lands in the OS temp directory under a name each language's own temp-file helper picks, so path is declared host-decided and pinned by pattern: the pattern carries the prefix and the extension, which is the half of the name the two languages derive differently.",
  "cases": [
    {
      "name": "rejects an invalid format",
      "args": {
        "format": "xml"
      },
      "expect_error": "format must be one of: json, csv, ndjson"
    },
    {
      "name": "exports the seeded events as json",
      "audit_store": {
        "events": [
