{
  "tool": "linode_profile_security_question_answer",
  "description": "Answer-count, per-item and uniqueness rejections, the answer POST body, and the preview that redacts each answer while leaving its question id readable.",
  "cases": [
    {
      "name": "rejects wrong answer count",
      "args": {
        "security_questions": [],
        "confirm": true
      },
      "expect_error": "security_questions must contain exactly 3 answers"
    },
    {
      "name": "rejects a too-short response",
      "args": {
        "security_questions": [
          {
            "question_id": 1,
            "response": "ab"
          },
          {
            "question_id": 2,
            "response": "abcdef"
          },
          {
            "question_id": 3,
            "response": "ghijkl"
          }
        ],
        "confirm": true
      },
      "expect_error": "response length must be between 3 and 17 characters"
    },
    {
      "name": "answers profile security questions",
      "args": {
        "security_questions": [
          {
            "question_id": 1,
            "response": "abcdef"
          },
          {
            "question_id": 2,
            "response": "ghijkl"
          },
          {
            "question_id": 3,
            "response": "mnopqr"
          }
        ],
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/profile/security-questions",
        "body": {
          "security_questions": [
            {
              "question_id": 1,
              "response": "abcdef"
            },
            {
              "question_id": 2,
              "response": "ghijkl"
            },
            {
              "question_id": 3,
              "response": "mnopqr"
            }
          ]
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "security_questions": [
          {
            "question_id": 1,
            "response": "abcdef"
          },
          {
            "question_id": 2,
            "response": "ghijkl"
          },
          {
            "question_id": 3,
            "response": "mnopqr"
          }
        ]
      },
      "expect_error": "This submits profile security question answers. Set confirm=true to proceed."
    },
    {
      "name": "rejects duplicate question ids",
      "args": {
        "security_questions": [
          {
            "question_id": 1,
            "response": "abcdef"
          },
          {
            "question_id": 1,
            "response": "ghijkl"
          },
          {
            "question_id": 3,
            "response": "mnopqr"
          }
        ],
        "confirm": true
      },
      "expect_error": "question_id values must be unique"
    },
    {
      "name": "rejects a non-positive question id",
      "args": {
        "security_questions": [
          {
            "question_id": 0,
            "response": "abcdef"
          },
          {
            "question_id": 2,
            "response": "ghijkl"
          },
          {
            "question_id": 3,
            "response": "mnopqr"
          }
        ],
        "confirm": true
      },
      "expect_error": "question_id must be a positive integer"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "security_questions": [
          {
            "question_id": 1,
            "response": "abcdef"
          },
          {
            "question_id": 2,
            "response": "ghijkl"
          },
          {
            "question_id": 3,
            "response": "mnopqr"
          }
        ],
        "dry_run": true
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_profile_security_question_answer",
        "would_execute": {
          "method": "POST",
          "path": "/profile/security-questions",
          "body": {
            "security_questions": [
              {
                "question_id": 1,
                "response": "[redacted]"
              },
              {
                "question_id": 2,
                "response": "[redacted]"
              },
              {
                "question_id": 3,
                "response": "[redacted]"
              }
            ]
          }
        },
        "current_state": null,
        "dependencies": [],
        "side_effects": [
          "The profile's security question answers are saved."
        ],
        "warnings": []
      }
    }
  ]
}
