{
  "tool": "linode_nodebalancer_create",
  "description": "Pins the create POST body and the shared region-required rejection (with confirm set). Missing-confirm text and zero-throttle body diverge (see report). A response that is not a JSON object must fail rather than yield a zeroed NodeBalancer; the bare-array shape of that case is withheld because Python still fabricates a success from it (see report).",
  "cases": [
    {
      "name": "rejects missing region",
      "args": {
        "confirm": true
      },
      "expect_error": "region is required"
    },
    {
      "name": "posts the create body",
      "args": {
        "region": "us-east",
        "client_conn_throttle": 20,
        "confirm": true
      },
      "api_response": {
        "id": 100,
        "label": "web-lb",
        "region": "us-east"
      },
      "expect_request": {
        "method": "POST",
        "path": "/nodebalancers",
        "body": {
          "region": "us-east",
          "client_conn_throttle": 20
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "region": "us-east",
        "client_conn_throttle": 20
      },
      "expect_error": "This operation creates a billable resource. Set confirm=true to proceed."
    },
    {
      "name": "rejects a non-object API response",
      "args": {
        "region": "us-east",
        "client_conn_throttle": 20,
        "confirm": true
      },
      "api_response": 7,
      "expect_api_error": "Failed to create NodeBalancer"
    },
    {
      "name": "sends the tags array in the body",
      "args": {
        "confirm": true,
        "region": "us-east",
        "tags": [
          "prod",
          "web"
        ]
      },
      "api_response": {
        "id": 100,
        "label": "web-lb",
        "region": "us-east"
      },
      "expect_request": {
        "method": "POST",
        "path": "/nodebalancers",
        "body": {
          "region": "us-east",
          "tags": [
            "prod",
            "web"
          ]
        }
      }
    },
    {
      "name": "rejects a tags value that is not an array",
      "args": {
        "confirm": true,
        "region": "us-east",
        "tags": 5
      },
      "expect_error": "tags must be a JSON string array"
    },
    {
      "name": "rejects a blank tag entry",
      "args": {
        "confirm": true,
        "region": "us-east",
        "tags": [
          "prod",
          "  "
        ]
      },
      "expect_error": "tags entries must be non-empty strings"
    },
    {
      "name": "carries configs, vpcs, and firewall_id into the body",
      "args": {
        "region": "us-east",
        "confirm": true,
        "firewall_id": 88,
        "configs": [
          {
            "port": 80,
            "protocol": "http"
          }
        ],
        "vpcs": [
          {
            "subnet_id": 7
          }
        ]
      },
      "api_response": {
        "id": 1,
        "label": "nb",
        "region": "us-east"
      },
      "expect_request": {
        "method": "POST",
        "path": "/nodebalancers",
        "body": {
          "region": "us-east",
          "firewall_id": 88,
          "configs": [
            {
              "port": 80,
              "protocol": "http"
            }
          ],
          "vpcs": [
            {
              "subnet_id": 7
            }
          ]
        }
      }
    },
    {
      "name": "rejects a configs value that is not an array of objects",
      "args": {
        "region": "us-east",
        "confirm": true,
        "configs": 5
      },
      "expect_error": "configs must be an array of objects"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "region": "us-east",
        "label": "web-lb",
        "ipv4": "192.0.2.10",
        "dry_run": true
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_nodebalancer_create",
        "would_execute": {
          "method": "POST",
          "path": "/nodebalancers",
          "body": {
            "region": "us-east",
            "label": "web-lb",
            "ipv4": "192.0.2.10"
          }
        },
        "current_state": null,
        "dependencies": [],
        "side_effects": [
          "A new NodeBalancer \"web-lb\" will be created in region us-east. Reserved IPv4 address 192.0.2.10 will be assigned."
        ],
        "warnings": [
          "Billing for the NodeBalancer starts immediately on creation."
        ]
      }
    }
  ]
}
