{
  "tool": "linode_account_oauth_client_delete",
  "description": "OAuth client delete: the three id sentences the contract carries, the confirm gate, the single DELETE once confirmed, and the preview that reads the client.",
  "cases": [
    {
      "name": "requires client_id",
      "args": {
        "confirm": true
      },
      "expect_error": "client_id is required"
    },
    {
      "name": "rejects a client_id with path separators",
      "args": {
        "client_id": "abc/123",
        "confirm": true
      },
      "expect_error": "client_id must not contain path separators, query separators, or traversal segments"
    },
    {
      "name": "requires confirm before deleting",
      "args": {
        "client_id": "abc123"
      },
      "expect_error": "This deletes an OAuth client. Set confirm=true to proceed."
    },
    {
      "name": "deletes an OAuth client",
      "args": {
        "client_id": "abc123",
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "DELETE",
        "path": "/account/oauth-clients/abc123"
      }
    },
    {
      "name": "dry_run_preview",
      "args": {
        "client_id": "abc123",
        "dry_run": true
      },
      "api_responses": {
        "GET /account/oauth-clients/abc123": {
          "id": "abc123",
          "label": "ci-client",
          "redirect_uri": "https://example.test/callback",
          "status": "active",
          "thumbnail_url": "https://example.test/thumb.png",
          "public": false
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_account_oauth_client_delete",
        "would_execute": {
          "method": "DELETE",
          "path": "/account/oauth-clients/abc123"
        },
        "current_state": {
          "id": "abc123",
          "label": "ci-client",
          "redirect_uri": "https://example.test/callback",
          "status": "active",
          "thumbnail_url": "https://example.test/thumb.png",
          "public": false
        },
        "dependencies": [],
        "side_effects": [
          "The account OAuth client is deleted."
        ],
        "warnings": []
      }
    }
  ]
}
