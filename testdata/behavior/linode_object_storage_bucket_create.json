{
  "tool": "linode_object_storage_bucket_create",
  "description": "Pins the shared label/region validation (behind confirm) and the create POST body. The confirm-gate message text itself diverges, so every case carries confirm:true. A success body that is not a JSON object must fail rather than turn into a zeroed bucket record.",
  "cases": [
    {
      "name": "rejects label shorter than 3 characters",
      "args": {
        "label": "ab",
        "region": "us-east",
        "confirm": true
      },
      "expect_error": "bucket label must be at least 3 characters"
    },
    {
      "name": "requires region",
      "args": {
        "label": "my-bucket",
        "confirm": true
      },
      "expect_error": "region is required"
    },
    {
      "name": "creates a bucket",
      "args": {
        "label": "test-bucket",
        "region": "us-east",
        "acl": "private",
        "confirm": true
      },
      "api_response": {
        "label": "test-bucket",
        "region": "us-east"
      },
      "expect_request": {
        "method": "POST",
        "path": "/object-storage/buckets",
        "body": {
          "label": "test-bucket",
          "region": "us-east",
          "acl": "private"
        }
      }
    },
    {
      "name": "rejects an invalid acl",
      "args": {
        "label": "test-bucket",
        "region": "us-east",
        "acl": "bogus",
        "confirm": true
      },
      "expect_error": "acl must be one of: private, public-read, authenticated-read, public-read-write"
    },
    {
      "name": "requires confirm",
      "args": {
        "label": "test-bucket",
        "region": "us-east",
        "acl": "private"
      },
      "expect_error": "This operation creates a billable resource. Set confirm=true to proceed."
    },
    {
      "name": "rejects a numeric API response",
      "args": {
        "label": "test-bucket",
        "region": "us-east",
        "acl": "private",
        "confirm": true
      },
      "api_response": 7,
      "expect_api_error": "Failed to create bucket"
    },
    {
      "name": "rejects a boolean API response",
      "args": {
        "label": "test-bucket",
        "region": "us-east",
        "acl": "private",
        "confirm": true
      },
      "api_response": true,
      "expect_api_error": "Failed to create bucket"
    },
    {
      "name": "rejects a populated-array API response",
      "args": {
        "label": "test-bucket",
        "region": "us-east",
        "acl": "private",
        "confirm": true
      },
      "api_response": [
        1,
        2
      ],
      "expect_api_error": "Failed to create bucket"
    },
    {
      "name": "carries endpoint_type and s3_endpoint into the body",
      "args": {
        "label": "my-bucket",
        "region": "us-east-1",
        "confirm": true,
        "endpoint_type": "E3",
        "s3_endpoint": "us-east-1.linodeobjects.com"
      },
      "api_response": {
        "label": "my-bucket",
        "region": "us-east-1"
      },
      "expect_request": {
        "method": "POST",
        "path": "/object-storage/buckets",
        "body": {
          "label": "my-bucket",
          "region": "us-east-1",
          "endpoint_type": "E3",
          "s3_endpoint": "us-east-1.linodeobjects.com"
        }
      }
    },
    {
      "name": "rejects an unknown endpoint_type",
      "args": {
        "label": "my-bucket",
        "region": "us-east-1",
        "confirm": true,
        "endpoint_type": "E9"
      },
      "expect_error": "endpoint_type must be one of: E0, E1, E2, E3"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "label": "my-bucket",
        "region": "us-east",
        "dry_run": true
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_object_storage_bucket_create",
        "would_execute": {
          "method": "POST",
          "path": "/object-storage/buckets",
          "body": {
            "label": "my-bucket",
            "region": "us-east"
          }
        },
        "current_state": null,
        "dependencies": [],
        "side_effects": [
          "A new Object Storage bucket \"my-bucket\" will be created in us-east."
        ],
        "warnings": [
          "Billing for Object Storage starts immediately on creation."
        ]
      }
    }
  ]
}
