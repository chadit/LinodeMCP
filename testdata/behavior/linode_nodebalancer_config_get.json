{
  "tool": "linode_nodebalancer_config_get",
  "description": "Pins the config GET path. Missing/invalid id error text diverges between languages (see report).",
  "cases": [
    {
      "name": "requires nodebalancer_id",
      "args": {},
      "expect_error": "nodebalancer_id is required"
    },
    {
      "name": "rejects a non-positive nodebalancer_id",
      "args": {
        "nodebalancer_id": 0
      },
      "expect_error": "nodebalancer_id must be a positive integer"
    },
    {
      "name": "requires config_id",
      "args": {
        "nodebalancer_id": 1
      },
      "expect_error": "config_id is required"
    },
    {
      "name": "rejects a non-positive config_id",
      "args": {
        "nodebalancer_id": 1,
        "config_id": 0
      },
      "expect_error": "config_id must be a positive integer"
    },
    {
      "name": "gets a config by ids",
      "args": {
        "nodebalancer_id": 456,
        "config_id": 7
      },
      "api_response": {
        "id": 7,
        "nodebalancer_id": 456,
        "port": 80,
        "protocol": "http"
      },
      "expect_request": {
        "method": "GET",
        "path": "/nodebalancers/456/configs/7"
      }
    }
  ]
}
