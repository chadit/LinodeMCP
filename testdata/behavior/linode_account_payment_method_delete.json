{
  "tool": "linode_account_payment_method_delete",
  "description": "Account payment method delete: the id rule, the confirm gate, the single DELETE once confirmed, and the preview that reads the method.",
  "cases": [
    {
      "name": "rejects a non-positive payment_method_id",
      "args": {
        "payment_method_id": 0,
        "confirm": true
      },
      "expect_error": "payment_method_id must be a positive integer"
    },
    {
      "name": "requires confirm before deleting",
      "args": {
        "payment_method_id": 123
      },
      "expect_error": "This deletes a payment method. Set confirm=true to proceed."
    },
    {
      "name": "deletes a payment method",
      "args": {
        "payment_method_id": 123,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "DELETE",
        "path": "/account/payment-methods/123"
      }
    },
    {
      "name": "dry_run_preview",
      "args": {
        "payment_method_id": 123,
        "dry_run": true
      },
      "api_responses": {
        "GET /account/payment-methods/123": {
          "data": {
            "card_type": "Visa",
            "expiry": "12/2030",
            "last_four": "1111"
          },
          "type": "credit_card",
          "id": 123,
          "is_default": true
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_account_payment_method_delete",
        "would_execute": {
          "method": "DELETE",
          "path": "/account/payment-methods/123"
        },
        "current_state": {
          "data": {
            "card_type": "Visa",
            "expiry": "12/2030",
            "last_four": "1111"
          },
          "type": "credit_card",
          "id": 123,
          "is_default": true
        },
        "dependencies": [],
        "side_effects": [
          "The selected account payment method is deleted."
        ],
        "warnings": []
      }
    }
  ]
}
