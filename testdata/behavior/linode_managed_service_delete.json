{
  "tool": "linode_managed_service_delete",
  "description": "Service delete: the id rule, the confirm gate, the DELETE (Admin, not Destroy), and the preview that reads the monitor.",
  "cases": [
    {
      "name": "rejects a non-positive service_id",
      "args": {
        "service_id": 0,
        "confirm": true
      },
      "expect_error": "service_id must be a positive integer"
    },
    {
      "name": "requires confirm before deleting",
      "args": {
        "service_id": 4
      },
      "expect_error": "This deletes a Managed service monitor. Set confirm=true to proceed."
    },
    {
      "name": "deletes a managed service",
      "args": {
        "service_id": 4,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "DELETE",
        "path": "/managed/services/4"
      }
    },
    {
      "name": "dry_run_preview",
      "args": {
        "service_id": 4,
        "dry_run": true
      },
      "api_responses": {
        "GET /managed/services/4": {
          "address": "https://example.com",
          "body": null,
          "consultation_group": "",
          "created": "",
          "credentials": null,
          "id": 4,
          "label": "web",
          "notes": null,
          "region": null,
          "service_type": "url",
          "status": "ok",
          "timeout": 30,
          "updated": ""
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_managed_service_delete",
        "would_execute": {
          "method": "DELETE",
          "path": "/managed/services/4"
        },
        "current_state": {
          "address": "https://example.com",
          "body": null,
          "consultation_group": "",
          "created": "",
          "credentials": null,
          "id": 4,
          "label": "web",
          "notes": null,
          "region": null,
          "service_type": "url",
          "status": "ok",
          "timeout": 30,
          "updated": ""
        },
        "dependencies": [],
        "side_effects": [
          "Managed service monitor 4 will be deleted."
        ],
        "warnings": []
      }
    }
  ]
}
