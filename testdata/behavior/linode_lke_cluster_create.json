{
  "tool": "linode_lke_cluster_create",
  "description": "Pins the label/region/k8s_version/node_pools rejections (checked in the order the rules declare), the confirmed POST body, and the arg-only dry-run preview. A response that is not a JSON object must fail rather than yield a zeroed cluster.",
  "cases": [
    {
      "name": "rejects missing label",
      "args": {
        "confirm": true,
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ]
      },
      "expect_error": "label is required"
    },
    {
      "name": "rejects missing region",
      "args": {
        "label": "prod",
        "confirm": true,
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ]
      },
      "expect_error": "region is required"
    },
    {
      "name": "rejects missing k8s_version",
      "args": {
        "label": "prod",
        "region": "us-east",
        "confirm": true,
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ]
      },
      "expect_error": "k8s_version is required"
    },
    {
      "name": "rejects empty node_pools",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [],
        "confirm": true
      },
      "expect_error": "node_pools must contain at least one node pool"
    },
    {
      "name": "creates a cluster",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ],
        "confirm": true
      },
      "api_response": {
        "id": 12345,
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31"
      },
      "expect_request": {
        "method": "POST",
        "path": "/lke/clusters",
        "body": {
          "label": "prod",
          "region": "us-east",
          "k8s_version": "1.31",
          "node_pools": [
            {
              "type": "g6-standard-1",
              "count": 3
            }
          ]
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ]
      },
      "expect_error": "This creates billable Kubernetes resources. Set confirm=true to proceed."
    },
    {
      "name": "rejects a bare-array API response",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ],
        "confirm": true
      },
      "api_response": [],
      "expect_api_error": "Failed to create LKE cluster"
    },
    {
      "name": "rejects a non-object API response",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ],
        "confirm": true
      },
      "api_response": 7,
      "expect_api_error": "Failed to create LKE cluster"
    },
    {
      "name": "carries tier, apl_enabled, stack_type, and the VPC placement",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ],
        "confirm": true,
        "tier": "enterprise",
        "apl_enabled": true,
        "stack_type": "ipv4-ipv6",
        "vpc_id": 42,
        "subnet_id": 7
      },
      "api_response": {
        "id": 1,
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31"
      },
      "expect_request": {
        "method": "POST",
        "path": "/lke/clusters",
        "body": {
          "label": "prod",
          "region": "us-east",
          "k8s_version": "1.31",
          "node_pools": [
            {
              "type": "g6-standard-1",
              "count": 3
            }
          ],
          "tier": "enterprise",
          "apl_enabled": true,
          "stack_type": "ipv4-ipv6",
          "vpc_id": 42,
          "subnet_id": 7
        }
      }
    },
    {
      "name": "rejects an unknown tier",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ],
        "confirm": true,
        "tier": "platinum"
      },
      "expect_error": "tier must be one of: standard, enterprise"
    },
    {
      "name": "rejects a non-boolean apl_enabled",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ],
        "confirm": true,
        "apl_enabled": "yes"
      },
      "expect_error": "apl_enabled must be a boolean"
    },
    {
      "name": "rejects a non-positive vpc_id",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ],
        "confirm": true,
        "vpc_id": 0
      },
      "expect_error": "vpc_id must be an integer greater than or equal to 1"
    },
    {
      "name": "rejects a non-positive subnet_id",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ],
        "confirm": true,
        "subnet_id": 0
      },
      "expect_error": "subnet_id must be an integer greater than or equal to 1"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ],
        "dry_run": true
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_lke_cluster_create",
        "would_execute": {
          "method": "POST",
          "path": "/lke/clusters",
          "body": {
            "label": "prod",
            "region": "us-east",
            "k8s_version": "1.31",
            "node_pools": [
              {
                "type": "g6-standard-1",
                "count": 3
              }
            ]
          }
        },
        "current_state": null,
        "dependencies": [],
        "side_effects": [
          "A new LKE cluster \"prod\" will be created in region us-east running Kubernetes 1.31."
        ],
        "warnings": [
          "Billing for the cluster's node pools starts immediately on creation."
        ]
      }
    },
    {
      "name": "rejects a stack type the route does not offer",
      "args": {
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31",
        "node_pools": [
          {
            "type": "g6-standard-1",
            "count": 3
          }
        ],
        "confirm": true,
        "stack_type": "ipv6"
      },
      "expect_error": "stack_type must be one of: ipv4, ipv4-ipv6"
    }
  ]
}
