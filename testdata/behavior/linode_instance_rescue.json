{
  "tool": "linode_instance_rescue",
  "description": "Pins the linode_id rejection, the devices reader's object-only sentence, and the rescue POST. Both languages omit devices when the caller does not supply them, so a minimal call sends an empty body. A supplied devices map is sent verbatim. The preview reads the instance so a running one is warned about.",
  "cases": [
    {
      "name": "requires linode_id",
      "args": {
        "confirm": true
      },
      "expect_error": "linode_id must be a positive integer"
    },
    {
      "name": "boots into rescue mode with the API default devices",
      "args": {
        "linode_id": 5,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/rescue",
        "body": {}
      }
    },
    {
      "name": "boots into rescue mode with explicit devices",
      "args": {
        "linode_id": 5,
        "devices": {
          "sda": {
            "disk_id": 123
          }
        },
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/rescue",
        "body": {
          "devices": {
            "sda": {
              "disk_id": 123
            }
          }
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "linode_id": 5,
        "devices": {
          "sda": {
            "disk_id": 123
          }
        }
      },
      "expect_error": "This reboots the instance into rescue mode. Set confirm=true to proceed."
    },
    {
      "name": "rejects a devices argument that is not an object",
      "args": {
        "linode_id": 5,
        "devices": "{\"sda\":{\"disk_id\":123}}",
        "confirm": true
      },
      "expect_error": "devices must be an object"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "linode_id": 5,
        "devices": {
          "sda": {
            "disk_id": 123
          }
