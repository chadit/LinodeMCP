{
  "tool": "linode_instance_disk_password_reset",
  "description": "Pins the id and root-password rejections, the password-reset POST body, and the preview, whose reported body stands in for the secret rather than echoing it.",
  "cases": [
    {
      "name": "rejects missing linode_id",
      "args": { "confirm": true },
      "expect_error": "linode_id must be a positive integer"
    },
    {
      "name": "rejects missing disk_id",
      "args": { "linode_id": 123, "confirm": true },
      "expect_error": "disk_id must be a positive integer"
    },
    {
      "name": "rejects a disk_id below one",
      "args": { "linode_id": 123, "disk_id": 0, "confirm": true },
      "expect_error": "disk_id must be a positive integer"
    },
    {
      "name": "rejects missing password",
      "args": { "linode_id": 123, "disk_id": 5, "confirm": true },
      "expect_error": "password is required"
    },
    {
      "name": "rejects a blank password",
      "args": { "linode_id": 123, "disk_id": 5, "confirm": true, "password": "   " },
      "expect_error": "password is required"
    },
    {
      "name": "rejects a password under twelve characters",
      "args": { "linode_id": 123, "disk_id": 5, "confirm": true, "password": "S3curePas" },
      "expect_error": "root_pass must be at least 12 characters"
    },
    {
      "name": "rejects a password naming no digit",
      "args": { "linode_id": 123, "disk_id": 5, "confirm": true, "password": "SecurePassWord" },
      "expect_error": "root_pass must contain uppercase, lowercase, and digits"
    },
    {
      "name": "rejects a password that is not a string",
      "args": { "linode_id": 123, "disk_id": 5, "confirm": true, "password": 7 },
      "expect_error": "password must be a string"
    },
    {
      "name": "resets a disk root password",
      "args": { "linode_id": 123, "disk_id": 5, "confirm": true, "password": "S3curePass123" },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/123/disks/5/password",
        "body": { "password": "S3curePass123" }
      }
    },
    {
      "name": "requires confirm",
      "args": { "linode_id": 123, "disk_id": 5, "password": "S3curePass123" },
      "expect_error": "This resets the root password for a disk. Set confirm=true to proceed."
    },
    {
      "name": "dry_run_preview",
      "args": { "linode_id": 123, "disk_id": 5, "password": "S3curePass123", "dry_run": true },
      "api_responses": {
        "GET /linode/instances/123/disks/5": {
          "created": "",
          "filesystem": "ext4",
          "id": 5,
          "label": "boot-disk",
          "size": 25600,
          "status": "ready",
          "updated": ""
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_instance_disk_password_reset",
        "would_execute": {
          "method": "POST",
          "path": "/linode/instances/123/disks/5/password",
          "body": { "password": { "redacted": true } }
        },
        "current_state": {
          "created": "",
          "filesystem": "ext4",
          "id": 5,
          "label": "boot-disk",
          "size": 25600,
          "status": "ready",
          "updated": ""
        },
        "dependencies": [],
        "side_effects": ["The root password for disk 5 on instance 123 will be reset."],
        "warnings": ["Existing disk root password access will be replaced."]
      }
    }
  ]
}
