            "status": "enabled",
            "tags": [
              "prod"
            ],
            "created": "2024-05-01T00:01:01",
            "updated": "2024-05-02T00:01:01"
          }
        ],
        "dependencies": [],
        "side_effects": [
          "Firewall assignments for Linode 123 will be replaced."
        ],
        "warnings": []
      }
    },
