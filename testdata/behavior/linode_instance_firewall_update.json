      "expect_request": {
        "method": "PUT",
        "path": "/linode/instances/123/firewalls",
        "body": {
          "firewall_ids": []
        }
      }
    },
    {
      "name": "requires firewall_ids",
      "args": {
        "linode_id": 123,
        "confirm": true
      },
      "expect_error": "firewall_ids is required"
    },
    {
      "name": "rejects a non-positive firewall id",
      "args": {
        "linode_id": 123,
        "firewall_ids": [
          0
        ],
        "confirm": true
      },
      "expect_error": "firewall_ids entries must be positive integers"
    },
    {
      "name": "rejects firewall_ids that is not an array",
      "args": {
        "linode_id": 123,
        "firewall_ids": "1",
        "confirm": true
      },
      "expect_error": "firewall_ids must be an array of integers"
    },
    {
      "name": "requires linode_id",
      "args": {
        "firewall_ids": [
          1
        ],
        "confirm": true
      },
      "expect_error": "linode_id is required"
    },
    {
      "name": "rejects a non-positive linode_id",
      "args": {
        "linode_id": 0,
        "firewall_ids": [
          1
        ],
        "confirm": true
      },
      "expect_error": "linode_id must be a positive integer"
    },
    {
      "name": "rejects a page below the minimum",
      "args": {
        "linode_id": 123,
        "firewall_ids": [
          1
        ],
        "page": 0,
        "confirm": true
      },
      "expect_error": "page must be an integer greater than or equal to 1"
    },
    {
      "name": "rejects a page_size out of range",
      "args": {
        "linode_id": 123,
        "firewall_ids": [
          1
        ],
        "page_size": 501,
        "confirm": true
      },
      "expect_error": "page_size must be an integer from 25 through 500"
    },
