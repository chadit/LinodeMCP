    },
    {
      "name": "sends the empty list that removes every assignment",
      "args": {
        "linode_id": 123,
        "firewall_ids": [],
        "confirm": true
      },
      "api_response": {
        "data": [],
        "page": 1,
        "pages": 1,
        "results": 0
