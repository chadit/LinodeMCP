{
  "tool": "linode_instance_firewall_update",
  "description": "Firewall assignment replace: PUTs the firewall_ids body, forwards the page controls it publishes, and decodes the documented paginated response envelope into the count and the firewalls. Every rejection text is now one sentence both languages answer.",
  "cases": [
    {
      "name": "accepts an empty firewall_ids",
      "args": {
        "linode_id": 1,
        "firewall_ids": [],
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "PUT",
        "path": "/linode/instances/1/firewalls",
        "body": {
          "firewall_ids": []
        }
      }
    },
    {
      "name": "replaces firewall assignments with the firewall_ids body",
      "args": {
        "linode_id": 123,
        "firewall_ids": [
          1,
          2
        ],
        "confirm": true
      },
      "api_response": {
        "data": [],
        "page": 1,
        "pages": 1,
        "results": 0
      },
      "expect_request": {
        "method": "PUT",
        "path": "/linode/instances/123/firewalls",
        "body": {
          "firewall_ids": [
            1,
            2
          ]
        }
      }
    },
    {
