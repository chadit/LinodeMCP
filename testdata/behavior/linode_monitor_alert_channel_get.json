{
  "tool": "linode_monitor_alert_channel_get",
  "description": "Alert channel get. The populated case pins the decode of a real channel: alerts is one summary object and details is the writable half the API echoes back.",
  "cases": [
    {
      "name": "rejects a non-positive channel_id",
      "args": { "channel_id": 0 },
      "expect_error": "channel_id must be a positive integer"
    },
    {
      "name": "gets an alert channel",
      "args": { "channel_id": 7 },
      "api_response": {
        "id": 7,
        "label": "ops on call",
        "type": "user",
        "channel_type": "email",
        "content": { "email": { "email_addresses": ["ops@example.com"] } },
        "details": { "email": { "recipient_type": "user", "usernames": ["opsuser"] } },
        "alerts": {
          "alert_count": 2,
          "type": "alert-definitions",
          "url": "/monitor/alert-channels/7/alerts"
        },
        "created": "2026-01-02T03:04:05",
        "created_by": "opsuser",
        "updated": "2026-01-03T03:04:05",
        "updated_by": "opsuser"
      },
      "expect_request": { "method": "GET", "path": "/monitor/alert-channels/7" }
    }
  ]
}
