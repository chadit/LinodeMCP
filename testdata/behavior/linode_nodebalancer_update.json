{
  "tool": "linode_nodebalancer_update",
  "description": "Pins the update PUT body and the shared nodebalancer_id-required rejection (with confirm set). Go requires confirm; Python does not (see report). A response that is not a JSON object must fail rather than yield a zeroed NodeBalancer; the bare-array shape of that case is withheld because Python still fabricates a success from it (see report).",
  "cases": [
    {
      "name": "rejects missing nodebalancer_id",
      "args": {
        "confirm": true
      },
      "expect_error": "nodebalancer_id must be a positive integer"
    },
    {
      "name": "puts the update body",
      "args": {
        "nodebalancer_id": 789,
        "label": "newlabel",
        "confirm": true
      },
      "api_response": {
        "id": 789,
        "label": "newlabel",
        "region": "us-east"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/nodebalancers/789",
        "body": {
          "label": "newlabel"
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "nodebalancer_id": 789,
        "label": "newlabel"
      },
      "expect_error": "This updates a NodeBalancer. Set confirm=true to proceed."
    },
    {
      "name": "rejects a non-object API response",
      "args": {
        "nodebalancer_id": 789,
        "label": "newlabel",
        "confirm": true
      },
      "api_response": 7,
      "expect_api_error": "NodeBalancer"
    },
    {
      "name": "sends the tags array in the body",
      "args": {
        "confirm": true,
        "nodebalancer_id": 789,
        "label": "newlabel",
        "tags": [
          "prod",
          "web"
        ]
      },
      "api_response": {
        "id": 789,
        "label": "newlabel",
        "region": "us-east"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/nodebalancers/789",
        "body": {
          "label": "newlabel",
          "tags": [
            "prod",
            "web"
          ]
        }
      }
    },
    {
      "name": "rejects a tags value that is not an array",
      "args": {
        "confirm": true,
        "nodebalancer_id": 789,
        "label": "newlabel",
        "tags": 5
      },
      "expect_error": "tags must be a JSON string array"
    },
    {
      "name": "rejects a blank tag entry",
      "args": {
        "confirm": true,
        "nodebalancer_id": 789,
        "label": "newlabel",
        "tags": [
          "prod",
          "  "
        ]
      },
      "expect_error": "tags entries must be non-empty strings"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "nodebalancer_id": 789,
        "label": "newlabel",
        "client_conn_throttle": 5,
        "dry_run": true
      },
      "api_responses": {
        "GET /nodebalancers/789": {
          "id": 789,
          "label": "lb-1",
          "region": "us-east",
          "hostname": "nb-789.linode.com",
          "ipv4": "",
          "ipv6": "",
          "client_conn_throttle": 0,
          "transfer": {
            "in": 0,
            "out": 0,
            "total": 0
          },
          "tags": [],
          "created": "",
          "updated": ""
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_nodebalancer_update",
        "would_execute": {
          "method": "PUT",
          "path": "/nodebalancers/789",
          "body": {
            "label": "newlabel",
            "client_conn_throttle": 5
          }
        },
        "current_state": {
          "id": 789,
          "label": "lb-1",
          "region": "us-east",
          "hostname": "nb-789.linode.com",
          "ipv4": "",
          "ipv6": "",
          "client_conn_throttle": 0,
          "transfer": {
            "in": 0,
            "out": 0,
            "total": 0
          },
          "tags": [],
          "created": "",
          "updated": ""
        },
        "dependencies": [],
        "side_effects": [
          "Label changes from \"lb-1\" to \"newlabel\".",
          "Connection throttle is set to 5 connections per second per client IP."
        ],
        "warnings": []
      }
    }
  ]
}
