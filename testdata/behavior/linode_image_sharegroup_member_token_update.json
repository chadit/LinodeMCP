{
  "tool": "linode_image_sharegroup_member_token_update",
  "description": "With confirm set both languages reach the sharegroup_id check. Success PUTs the member token label.",
  "cases": [
    {
      "name": "rejects missing sharegroup_id",
      "args": {
        "confirm": true
      },
      "expect_error": "sharegroup_id must be a positive integer"
    },
    {
      "name": "rejects a negative sharegroup_id",
      "args": {
        "sharegroup_id": -5,
        "token_uuid": "123e4567-e89b-12d3-a456-426614174000",
        "label": "new-label",
        "confirm": true
      },
      "expect_error": "sharegroup_id must be a positive integer"
    },
    {
      "name": "rejects a blank token_uuid",
      "args": {
        "sharegroup_id": 5,
        "token_uuid": "   ",
        "label": "new-label",
        "confirm": true
      },
      "expect_error": "token_uuid must be a non-empty string"
    },
    {
      "name": "rejects a path-unsafe token_uuid",
      "args": {
        "sharegroup_id": 5,
        "token_uuid": "../../images",
        "label": "new-label",
        "confirm": true
      },
      "expect_error": "token_uuid must not contain path separators, query separators, fragments, or traversal segments"
    },
    {
      "name": "rejects a non-canonical token_uuid",
      "args": {
        "sharegroup_id": 5,
        "token_uuid": "123e4567e89b12d3a456426614174000",
        "label": "new-label",
        "confirm": true
      },
      "expect_error": "token_uuid must be a UUID"
    },
    {
      "name": "rejects a blank label",
      "args": {
        "sharegroup_id": 5,
        "token_uuid": "123e4567-e89b-12d3-a456-426614174000",
        "label": "   ",
        "confirm": true
      },
      "expect_error": "label is required"
    },
    {
      "name": "updates a member token label",
      "args": {
        "sharegroup_id": 5,
        "token_uuid": "123e4567-e89b-12d3-a456-426614174000",
        "label": "new-label",
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "PUT",
        "path": "/images/sharegroups/5/members/123e4567-e89b-12d3-a456-426614174000",
        "body": {
          "label": "new-label"
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "sharegroup_id": 5,
        "token_uuid": "123e4567-e89b-12d3-a456-426614174000",
        "label": "new-label"
      },
      "expect_error": "This updates an image share group member token. Set confirm=true to proceed."
    }
  ]
}
