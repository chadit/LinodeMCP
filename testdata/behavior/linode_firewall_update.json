{
  "tool": "linode_firewall_update",
  "description": "Firewall update takes firewall_id in the path and PUTs label/status/tags. The default policies travel inside `rules`, and that member stays off the wire when neither is named: this route reads it as a replacement, so an empty object would clear the ruleset. Both languages now gate on confirm before validating.",
  "cases": [
    {
      "name": "requires firewall_id",
      "args": {
        "confirm": true,
        "label": "renamed"
      },
      "expect_error": "firewall_id is required"
    },
    {
      "name": "updates label and status without touching rules",
      "args": {
        "confirm": true,
        "firewall_id": 123,
        "label": "renamed-fw",
        "status": "enabled"
      },
      "api_response": {},
      "expect_request": {
        "method": "PUT",
        "path": "/networking/firewalls/123",
        "body": {
          "label": "renamed-fw",
          "status": "enabled"
        }
      }
    },
    {
      "name": "folds a single policy into rules",
      "args": {
        "confirm": true,
        "firewall_id": 123,
        "inbound_policy": "DROP"
      },
      "api_response": {},
      "expect_request": {
        "method": "PUT",
        "path": "/networking/firewalls/123",
        "body": {
          "rules": {
            "inbound_policy": "DROP"
          }
        }
      }
    },
    {
      "name": "folds both policies into rules",
      "args": {
        "confirm": true,
        "firewall_id": 123,
        "inbound_policy": "DROP",
        "outbound_policy": "ACCEPT"
      },
      "api_response": {},
      "expect_request": {
        "method": "PUT",
        "path": "/networking/firewalls/123",
        "body": {
          "rules": {
            "inbound_policy": "DROP",
            "outbound_policy": "ACCEPT"
          }
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "firewall_id": 123,
        "label": "renamed-fw",
        "status": "enabled"
      },
      "expect_error": "This updates a Cloud Firewall. Set confirm=true to proceed."
    },
    {
      "name": "rejects an invalid inbound_policy (proto FirewallPolicy enum)",
      "args": {
        "confirm": true,
        "firewall_id": 123,
        "inbound_policy": "MAYBE"
      },
      "expect_error": "inbound_policy must be one of: ACCEPT, DROP"
    },
    {
      "name": "rejects an invalid outbound_policy (proto FirewallPolicy enum)",
      "args": {
        "confirm": true,
        "firewall_id": 123,
        "outbound_policy": "MAYBE"
      },
      "expect_error": "outbound_policy must be one of: ACCEPT, DROP"
    },
    {
      "name": "sends the tags array in the body",
      "args": {
        "confirm": true,
        "firewall_id": 123,
        "label": "renamed-fw",
        "tags": [
          "prod",
          "web"
        ]
      },
      "api_response": {},
      "expect_request": {
        "method": "PUT",
        "path": "/networking/firewalls/123",
        "body": {
          "label": "renamed-fw",
          "tags": [
            "prod",
            "web"
          ]
        }
      }
    },
    {
      "name": "rejects a tags value that is not an array",
      "args": {
        "confirm": true,
        "firewall_id": 123,
        "label": "renamed-fw",
        "tags": 5
      },
      "expect_error": "tags must be a JSON string array"
    },
    {
      "name": "rejects a blank tag entry",
      "args": {
        "confirm": true,
        "firewall_id": 123,
        "label": "renamed-fw",
        "tags": [
          "prod",
          "  "
        ]
      },
      "expect_error": "tags entries must be non-empty strings"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "firewall_id": 123,
        "label": "renamed-fw",
        "status": "disabled",
        "dry_run": true
      },
      "api_responses": {
        "GET /networking/firewalls/123": {
          "id": 123,
          "label": "web-fw",
          "status": "enabled",
          "created": "2026-01-01T00:00:00",
          "updated": "2026-01-01T00:00:00",
          "tags": [
            "prod"
          ],
          "rules": {
            "inbound_policy": "DROP",
            "outbound_policy": "ACCEPT",
            "inbound": [],
            "outbound": []
          }
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_firewall_update",
        "would_execute": {
          "method": "PUT",
          "path": "/networking/firewalls/123",
          "body": {
            "label": "renamed-fw",
            "status": "disabled"
          }
        },
        "current_state": {
          "id": 123,
          "label": "web-fw",
          "status": "enabled",
          "created": "2026-01-01T00:00:00",
          "updated": "2026-01-01T00:00:00",
          "tags": [
            "prod"
          ],
          "rules": {
            "inbound_policy": "DROP",
            "outbound_policy": "ACCEPT",
            "inbound": [],
            "outbound": []
          }
        },
        "dependencies": [],
        "side_effects": [
          "Label changes from \"web-fw\" to \"renamed-fw\".",
          "Firewall status changes to \"disabled\"; this immediately stops enforcing its rules."
        ],
        "warnings": []
      }
    },
    {
      "name": "rejects a status the route does not offer",
      "args": {
        "confirm": true,
        "firewall_id": 123,
        "label": "renamed-fw",
        "status": "paused"
      },
      "expect_error": "status must be one of: enabled, disabled"
    },
    {
      "name": "dry_run_preview_status_enabled",
      "args": {
        "firewall_id": 123,
        "status": "enabled",
        "dry_run": true
      },
      "api_responses": {
        "GET /networking/firewalls/123": {
          "id": 123,
          "label": "web-fw",
          "status": "disabled",
          "created": "2026-01-01T00:00:00",
          "updated": "2026-01-01T00:00:00",
          "tags": [
            "prod"
          ],
          "rules": {
            "inbound_policy": "DROP",
            "outbound_policy": "ACCEPT",
            "inbound": [],
            "outbound": []
          }
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_firewall_update",
        "would_execute": {
          "method": "PUT",
          "path": "/networking/firewalls/123",
          "body": {
            "status": "enabled"
          }
        },
        "current_state": {
          "id": 123,
          "label": "web-fw",
          "status": "disabled",
          "created": "2026-01-01T00:00:00",
          "updated": "2026-01-01T00:00:00",
          "tags": [
            "prod"
          ],
          "rules": {
            "inbound_policy": "DROP",
            "outbound_policy": "ACCEPT",
            "inbound": [],
            "outbound": []
          }
        },
        "dependencies": [],
        "side_effects": [
          "Firewall status changes to \"enabled\"; this immediately starts enforcing its rules."
        ],
        "warnings": []
      }
    }
  ]
}
