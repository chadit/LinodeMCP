{
  "tool": "linode_vlan_delete",
  "description": "VLAN delete needs region_id (a lowercase region slug, now enforced in both languages) and label, then DELETEs the region/label path when authorized.",
  "cases": [
    {
      "name": "confirm alone is blocked by the destroy gate",
      "args": {
        "region_id": "us-east",
        "label": "my-vlan",
        "confirm": true
      },
      "expect_error": "linode_vlan_delete is destructive. Either:\n  1. Call with dry_run: true first to preview, then call again with\n     confirm: true, confirmed_dry_run: true\n  2. Call with confirm: true, confirm_bypass_dry_run: true to skip preview\n  3. Use yolo: true (only if profile allows)"
    },
    {
      "name": "rejects a malformed region_id",
      "args": {
        "confirm": true,
        "confirm_bypass_dry_run": true,
        "region_id": "US_EAST",
        "label": "my-vlan"
      },
      "expect_error": "region_id must be a lowercase region slug"
    },
    {
      "name": "rejects a label carrying a path separator",
      "args": {
        "region_id": "us-east",
        "label": "vl/app",
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "expect_error": "label must not contain path separators, query separators, or traversal segments"
    },
    {
      "name": "requires region_id",
      "args": {
        "confirm": true,
        "confirm_bypass_dry_run": true,
        "label": "my-vlan"
      },
      "expect_error": "region_id is required"
    },
    {
      "name": "requires label",
      "args": {
        "confirm": true,
        "confirm_bypass_dry_run": true,
        "region_id": "us-east"
      },
      "expect_error": "label is required"
    },
    {
      "name": "deletes the vlan when authorized",
      "args": {
        "region_id": "us-east",
        "label": "my-vlan",
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "api_response": {},
      "expect_request": {
        "method": "DELETE",
        "path": "/networking/vlans/us-east/my-vlan"
      }
    },
    {
      "name": "rejects a malformed list body in the dry-run scan",
      "args": {
        "region_id": "us-east",
        "label": "my-vlan",
        "confirm": true,
        "dry_run": true
      },
      "expect_api_error": "Failed to fetch state for dry-run",
      "api_response_raw": "not json"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "region_id": "us-east",
        "label": "my-vlan",
        "dry_run": true
      },
      "api_responses": {
        "GET /networking/vlans": {
          "data": [
            {
              "label": "my-vlan",
              "linodes": [
                5
              ],
              "region": "us-east"
            }
          ],
          "page": 1,
          "pages": 1,
          "results": 1
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_vlan_delete",
        "would_execute": {
          "method": "DELETE",
          "path": "/networking/vlans/us-east/my-vlan"
        },
        "current_state": {
          "label": "my-vlan",
          "linodes": [
            5
          ],
          "region": "us-east"
        },
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    },
    {
      "name": "a vlan the whole collection does not carry reads as missing",
      "args": {
        "region_id": "us-east",
        "label": "ghost",
        "dry_run": true
      },
      "api_response": {
        "data": [],
        "page": 1,
        "pages": 1,
        "results": 0
      },
      "expect_api_error": "collection holds no matching element: linode_vlan_list carries no element matching region='us-east', label='ghost'"
    }
  ]
}
