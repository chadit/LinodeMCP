{
  "tool": "linode_lke_cluster_get",
  "description": "Pins the cluster_id rejections and the single GET both languages issue. cluster_id is an integer path param.",
  "cases": [
    {
      "name": "rejects missing cluster_id",
      "args": {},
      "expect_error": "cluster_id is required"
    },
    {
      "name": "rejects a non-positive cluster_id",
      "args": {
        "cluster_id": 0
      },
      "expect_error": "cluster_id must be a positive integer"
    },
    {
      "name": "gets a cluster by id",
      "args": {
        "cluster_id": 12345
      },
      "api_response": {
        "id": 12345,
        "label": "prod",
        "region": "us-east",
        "k8s_version": "1.31"
      },
      "expect_request": {
        "method": "GET",
        "path": "/lke/clusters/12345"
      }
    }
  ]
}
