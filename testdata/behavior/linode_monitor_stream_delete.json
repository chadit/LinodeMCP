{
  "tool": "linode_monitor_stream_delete",
  "description": "Destroy tool. The preview case is what proves the synthesized state fetch: the tool declares no fetch_state hook, so both languages read the stream through linode_monitor_stream_get, the sibling declared on the same route, and report it as that read's own message.",
  "cases": [
    {
      "name": "rejects a non-positive stream_id",
      "args": {
        "stream_id": 0,
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "expect_error": "stream_id must be a positive integer"
    },
    {
      "name": "refuses a fractional stream_id rather than truncating it",
      "args": {
        "stream_id": 5.7,
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "expect_error": "stream_id must be a positive integer"
    },
    {
      "name": "confirm alone hits the destroy gate",
      "args": {
        "stream_id": 42,
        "confirm": true
      },
      "expect_error": "linode_monitor_stream_delete is destructive. Either:\n  1. Call with dry_run: true first to preview, then call again with\n     confirm: true, confirmed_dry_run: true\n  2. Call with confirm: true, confirm_bypass_dry_run: true to skip preview\n  3. Use yolo: true (only if profile allows)"
    },
    {
      "name": "deletes the monitor stream",
      "args": {
        "stream_id": 42,
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "api_response": {},
      "expect_request": {
        "method": "DELETE",
        "path": "/monitor/streams/42"
      }
    },
    {
      "name": "dry_run_preview",
      "args": {
        "stream_id": 42,
        "dry_run": true
      },
      "api_responses": {
        "GET /monitor/streams/42": {
