{
  "tool": "linode_nodebalancer_config_update",
  "description": "Pins the config-update PUT body plus Go's at-least-one-field/port/check/ssl body validation now ported to Python (strictest-wins). Rejection cases set confirm:true so both languages reach the body check despite the confirm-vs-body ordering difference. A response that is not a JSON object must fail rather than yield a zeroed config.",
  "cases": [
    {
      "name": "puts the config update body",
      "args": { "nodebalancer_id": 100, "config_id": 7, "port": 9090, "confirm": true },
      "api_response": { "id": 7, "nodebalancer_id": 100, "port": 9090, "protocol": "http" },
      "expect_request": {
        "method": "PUT",
        "path": "/nodebalancers/100/configs/7",
        "body": { "port": 9090 }
      }
    },
    {
      "name": "requires confirm",
      "args": {"nodebalancer_id": 100, "config_id": 7, "port": 9090},
      "expect_error": "This updates a NodeBalancer config. Set confirm=true to proceed."
    },
    {
      "name": "requires at least one update field",
      "args": {"nodebalancer_id": 100, "config_id": 7, "confirm": true},
      "expect_error": "at least one update field is required"
    },
    {
      "name": "rejects an out-of-range port",
      "args": {"nodebalancer_id": 100, "config_id": 7, "port": 99999, "confirm": true},
      "expect_error": "port must be an integer from 1 through 65535"
    },
    {
      "name": "rejects an invalid check",
      "args": {"nodebalancer_id": 100, "config_id": 7, "check": "bogus", "confirm": true},
      "expect_error": "check must be one of: none, connection, http, http_body"
    },
    {
      "name": "requires ssl_cert and ssl_key for https",
      "args": {"nodebalancer_id": 100, "config_id": 7, "protocol": "https", "confirm": true},
      "expect_error": "ssl_cert and ssl_key are required when protocol is https"
    },
    {
      "name": "rejects a bare-array API response",
      "args": { "nodebalancer_id": 100, "config_id": 7, "port": 9090, "confirm": true },
      "api_response": [],
      "expect_api_error": "Failed to update"
    },
    {
      "name": "rejects a non-object API response",
      "args": { "nodebalancer_id": 100, "config_id": 7, "port": 9090, "confirm": true },
      "api_response": 7,
      "expect_api_error": "Failed to update"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "nodebalancer_id": 5,
        "config_id": 7,
        "port": 8080,
        "dry_run": true
      },
      "api_responses": {
        "GET /nodebalancers/5/configs/7": {
          "algorithm": "",
          "check": "",
          "check_attempts": 0,
          "check_body": "",
          "check_interval": 0,
          "check_passive": false,
          "check_path": "",
          "check_timeout": 0,
          "cipher_suite": "",
          "id": 7,
          "nodebalancer_id": 5,
          "nodes_status": {
            "down": 0,
            "up": 0
          },
          "port": 80,
          "protocol": "http",
          "ssl_commonname": "",
          "ssl_fingerprint": "",
          "stickiness": ""
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_nodebalancer_config_update",
        "would_execute": {
          "method": "PUT",
          "path": "/nodebalancers/5/configs/7",
          "body": {
            "port": 8080
          }
        },
        "current_state": {
          "algorithm": "",
          "check": "",
          "check_attempts": 0,
          "check_body": "",
          "check_interval": 0,
          "check_passive": false,
          "check_path": "",
          "check_timeout": 0,
          "cipher_suite": "",
          "id": 7,
          "nodebalancer_id": 5,
          "nodes_status": {
            "down": 0,
            "up": 0
          },
          "port": 80,
          "protocol": "http",
          "ssl_commonname": "",
          "ssl_fingerprint": "",
          "stickiness": ""
        },
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    },
    {
      "name": "dry_run_preview redacts the TLS material",
      "args": {
        "nodebalancer_id": 5,
        "config_id": 7,
        "protocol": "https",
        "ssl_cert": "-----BEGIN CERTIFICATE-----",
        "ssl_key": "-----BEGIN PRIVATE KEY-----",
        "dry_run": true
      },
      "api_responses": {
        "GET /nodebalancers/5/configs/7": {
