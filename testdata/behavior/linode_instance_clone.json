            "vcpus": 0
          },
          "status": "",
          "tags": [],
          "type": "",
          "updated": "",
          "watchdog_enabled": false
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_instance_clone",
        "would_execute": {
          "method": "POST",
          "path": "/linode/instances/5/clone",
          "body": {
            "label": "clone-1"
          }
        },
        "current_state": {
          "alerts": {
            "cpu": 0,
