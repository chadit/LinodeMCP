            "network_out": 0,
            "transfer_quota": 0
          },
          "backups": {
            "available": false,
            "enabled": false,
            "last_successful": null,
            "schedule": {
              "day": "",
              "window": ""
            }
          },
          "created": "",
          "group": "",
          "hypervisor": "",
          "id": 0,
          "image": "",
          "ipv4": [],
          "ipv6": "",
          "label": "",
          "region": "",
          "specs": {
            "disk": 0,
