{
  "tool": "linode_instance_resize",
  "description": "Pins the resize contract: the CEL rules on instance_id, type and migration_type, the POST body, and the preview. Both languages omit allow_auto_disk_resize and migration_type unless the caller sets them (the API applies its own defaults: allow_auto_disk_resize=true, migration_type=cold), so a minimal call sends just type. Explicit values are sent verbatim.",
  "cases": [
    {
      "name": "rejects an instance_id below one",
      "args": {
        "instance_id": 0,
        "type": "g6-standard-2",
        "confirm": true
      },
      "expect_error": "instance_id must be a positive integer"
    },
    {
      "name": "requires type",
      "args": {
        "instance_id": 5,
        "confirm": true
      },
      "expect_error": "type is required"
    },
    {
      "name": "rejects a migration_type outside the set",
      "args": {
        "instance_id": 5,
        "type": "g6-standard-2",
        "migration_type": "sideways",
        "confirm": true
      },
      "expect_error": "migration_type must be one of: cold, warm"
    },
    {
      "name": "resizes the instance with API defaults",
      "args": {
        "instance_id": 5,
        "type": "g6-standard-2",
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/resize",
        "body": {
          "type": "g6-standard-2"
        }
      }
    },
    {
      "name": "resizes the instance with explicit options",
      "args": {
        "instance_id": 5,
        "type": "g6-standard-2",
        "allow_auto_disk_resize": true,
        "migration_type": "warm",
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/resize",
        "body": {
          "type": "g6-standard-2",
          "allow_auto_disk_resize": true,
          "migration_type": "warm"
        }
      }
    },
    {
      "name": "answers with the instance and the plan it is resizing to",
      "args": {
        "instance_id": 5,
        "type": "g6-standard-2",
        "confirm": true
      },
      "api_response": {},
      "expect_result": {
        "message": "Instance 5 resize to g6-standard-2 initiated successfully",
        "instance_id": 5,
        "new_type": "g6-standard-2"
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "instance_id": 5,
        "type": "g6-standard-2"
      },
      "expect_error": "This operation causes downtime and may affect billing. Set confirm=true to proceed."
    },
