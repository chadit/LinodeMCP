{
  "tool": "linode_nodebalancer_firewall_update",
  "description": "Pins the firewall-update PUT body, the page controls it forwards, and the decode of the documented paginated response envelope into the count and the firewalls. Rejection order and text are now one contract both languages read.",
  "cases": [
    {
      "name": "accepts an empty firewall_ids",
      "args": {
        "nodebalancer_id": 1,
        "firewall_ids": [],
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "PUT",
        "path": "/nodebalancers/1/firewalls",
        "body": {
          "firewall_ids": []
        }
      }
    },
    {
      "name": "puts the firewall assignments body",
      "args": {
        "nodebalancer_id": 5,
        "firewall_ids": [
          10,
          20
        ],
        "confirm": true
      },
      "api_response": {
        "data": [],
        "page": 1,
        "pages": 1,
        "results": 0
      },
      "expect_request": {
        "method": "PUT",
        "path": "/nodebalancers/5/firewalls",
        "body": {
          "firewall_ids": [
            10,
            20
          ]
        }
      }
    },
    {
      "name": "rejects a bare-array API response",
