{
  "tool": "linode_instance_mutate",
  "description": "Pins the upgrade contract: the id rule it declares, the boolean check on allow_auto_disk_resize, the confirm gate, and the POST it sends. Both languages omit allow_auto_disk_resize unless the caller sets it (API default true), so a minimal call sends an empty body and an explicit value travels verbatim. The preview reads the Linode whose type the upgrade replaces and carries both halves of what the two hand handlers said.",
  "cases": [
    {
      "name": "rejects a linode_id below one",
      "args": { "linode_id": 0, "confirm": true },
      "expect_error": "linode_id must be a positive integer"
    },
    {
      "name": "rejects non-boolean allow_auto_disk_resize",
      "args": { "linode_id": 5, "allow_auto_disk_resize": "yes", "confirm": true },
      "expect_error": "allow_auto_disk_resize must be a boolean"
    },
    {
      "name": "requires confirm",
      "args": { "linode_id": 5, "allow_auto_disk_resize": true },
      "expect_error": "This upgrades the instance and may cause downtime. Set confirm=true to proceed."
    },
    {
      "name": "mutates the instance with the API default",
      "args": { "linode_id": 5, "confirm": true },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/mutate",
        "body": {}
      }
    },
    {
      "name": "mutates the instance with an explicit option",
      "args": { "linode_id": 5, "allow_auto_disk_resize": true, "confirm": true },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/mutate",
        "body": { "allow_auto_disk_resize": true }
      }
    },
    {
      "name": "answers with the id the call named",
      "args": { "linode_id": 5, "confirm": true },
      "api_response": {},
      "expect_result": {
        "message": "Upgrade initiated for instance 5",
        "linode_id": 5
      }
    },
    {
      "name": "dry_run_preview",
      "args": { "linode_id": 5, "allow_auto_disk_resize": true, "dry_run": true },
      "api_responses": {
        "GET /linode/instances/5": {
          "alerts": {
            "cpu": 0,
            "io": 0,
            "network_in": 0,
            "network_out": 0,
            "transfer_quota": 0
          },
          "backups": {
            "available": false,
            "enabled": false,
            "last_successful": null,
            "schedule": {
              "day": "",
              "window": ""
            }
          },
          "created": "",
          "group": "",
          "hypervisor": "",
          "id": 5,
          "image": "",
          "ipv4": [],
          "ipv6": "",
          "label": "web-1",
          "region": "us-east",
          "specs": {
            "disk": 0,
            "gpus": 0,
            "memory": 0,
            "transfer": 0,
            "vcpus": 0
          },
          "status": "running",
          "tags": [],
          "type": "g6-standard-1",
          "updated": "",
          "watchdog_enabled": false
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_instance_mutate",
        "would_execute": {
          "method": "POST",
          "path": "/linode/instances/5/mutate",
          "body": { "allow_auto_disk_resize": true }
        },
        "current_state": {
          "alerts": {
            "cpu": 0,
            "io": 0,
            "network_in": 0,
            "network_out": 0,
            "transfer_quota": 0
          },
          "backups": {
