            "vcpus": 0
          },
          "status": "",
          "tags": [],
          "type": "",
          "updated": "",
          "watchdog_enabled": false
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_instance_backup_create",
        "would_execute": {
          "method": "POST",
          "path": "/linode/instances/123/backups",
          "body": {
            "label": "snap-1"
          }
        },
        "current_state": {
          "alerts": {
            "cpu": 0,
            "io": 0,
            "network_in": 0,
            "network_out": 0,
            "transfer_quota": 0
          },
          "backups": {
            "available": false,
            "enabled": false,
            "last_successful": null,
            "schedule": {
              "day": "",
              "window": ""
            }
          },
          "created": "",
          "group": "",
          "hypervisor": "",
          "id": 0,
          "image": "",
          "ipv4": [],
          "ipv6": "",
          "label": "",
          "region": "",
          "specs": {
            "disk": 0,
            "gpus": 0,
            "memory": 0,
            "transfer": 0,
            "vcpus": 0
          },
          "status": "",
          "tags": [],
          "type": "",
          "updated": "",
          "watchdog_enabled": false
        },
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    },
    {
      "name": "rejects a null API response",
      "args": {
        "linode_id": 123,
        "label": "snap-1",
        "confirm": true
      },
      "api_response": null,
      "expect_api_error": "Failed to create"
    },
    {
      "name": "rejects a bare-array API response",
      "args": {
        "linode_id": 123,
        "label": "snap-1",
        "confirm": true
      },
      "api_response": [],
      "expect_api_error": "Failed to create"
    },
    {
      "name": "rejects a populated-array API response",
      "args": {
        "linode_id": 123,
        "label": "snap-1",
        "confirm": true
      },
      "api_response": [
        1,
        2
      ],
      "expect_api_error": "Failed to create"
    },
    {
      "name": "rejects a string API response",
      "args": {
        "linode_id": 123,
        "label": "snap-1",
        "confirm": true
      },
      "api_response": "not-an-object",
      "expect_api_error": "Failed to create"
    },
    {
      "name": "rejects a numeric API response",
      "args": {
        "linode_id": 123,
        "label": "snap-1",
        "confirm": true
      },
      "api_response": 7,
      "expect_api_error": "Failed to create"
    },
    {
      "name": "rejects a boolean API response",
      "args": {
        "linode_id": 123,
        "label": "snap-1",
        "confirm": true
      },
      "api_response": true,
      "expect_api_error": "Failed to create"
    },
    {
      "name": "rejects a snapshot with no label",
      "args": {
        "linode_id": 123,
        "confirm": true
      },
      "expect_error": "label is required"
    }
  ]
}
