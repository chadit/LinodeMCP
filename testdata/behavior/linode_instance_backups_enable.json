{
  "tool": "linode_instance_backups_enable",
  "description": "Pins the linode_id rule its contract declares, the confirm gate, the bodyless POST, the id echo it answers with, and the preview reading the instance the backup service would be billed for.",
  "cases": [
    {
      "name": "rejects a linode_id below one",
      "args": {
        "linode_id": 0,
        "confirm": true
      },
      "expect_error": "linode_id must be a positive integer"
    },
    {
      "name": "requires confirm",
      "args": {
        "linode_id": 123
      },
      "expect_error": "Enabling backups adds a recurring charge to your account. Set confirm=true to proceed."
    },
    {
      "name": "enables backups with a plain POST",
      "args": {
        "linode_id": 123,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/123/backups/enable"
      }
    },
    {
      "name": "answers with the id the call named",
      "args": {
        "linode_id": 123,
        "confirm": true
      },
      "api_response": {},
      "expect_result": {
        "message": "Backup service enabled for instance 123",
        "linode_id": 123
      }
    },
    {
      "name": "dry_run_preview",
      "args": {
        "linode_id": 123,
        "dry_run": true
      },
      "api_responses": {
        "GET /linode/instances/123": {
