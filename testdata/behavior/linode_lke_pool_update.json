{
  "tool": "linode_lke_pool_update",
  "description": "The confirm gate runs before anything reads the arguments, so every argument case carries confirm. Both path ids collapse to one sentence: proto3 reads an absent int32 as 0, so a missing id and a zero id are the same value and the positive rule answers both. The dry run reads the pool so the resize sentence can name the count it starts from.",
  "cases": [
    {
      "name": "rejects a missing cluster_id",
      "args": {
        "confirm": true
      },
      "expect_error": "cluster_id must be a positive integer"
    },
    {
      "name": "rejects a negative cluster_id",
      "args": {
        "cluster_id": -1,
        "pool_id": 7,
        "confirm": true
      },
      "expect_error": "cluster_id must be a positive integer"
    },
    {
      "name": "rejects a missing pool_id",
      "args": {
        "cluster_id": 12345,
        "confirm": true
      },
      "expect_error": "pool_id must be a positive integer"
    },
    {
      "name": "rejects a negative pool_id",
      "args": {
        "cluster_id": 12345,
        "pool_id": -1,
        "confirm": true
      },
      "expect_error": "pool_id must be a positive integer"
    },
    {
      "name": "requires confirm",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "count": 5
      },
      "expect_error": "This modifies the node pool configuration. Set confirm=true to proceed."
    },
    {
      "name": "dry_run_preview",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "count": 5,
        "dry_run": true
      },
      "api_responses": {
        "GET /lke/clusters/12345/pools/7": {
          "autoscaler": null,
          "cluster_id": 0,
          "count": 2,
          "disks": null,
          "id": 7,
          "nodes": null,
          "tags": null,
          "type": "g6-standard-2"
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_lke_pool_update",
        "would_execute": {
          "method": "PUT",
          "path": "/lke/clusters/12345/pools/7",
          "body": {
            "count": 5
          }
        },
        "current_state": {
          "autoscaler": null,
          "cluster_id": 0,
          "count": 2,
          "disks": null,
          "id": 7,
          "nodes": null,
          "tags": null,
          "type": "g6-standard-2"
        },
        "dependencies": [],
        "side_effects": [
          "Node pool resizes from 2 to 5 node(s)."
        ],
        "warnings": []
      }
    },
    {
      "name": "updates a node pool count",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "count": 5,
        "confirm": true
      },
      "api_response": {
        "id": 7,
        "cluster_id": 12345,
        "count": 5
      },
      "expect_request": {
        "method": "PUT",
        "path": "/lke/clusters/12345/pools/7",
        "body": {
          "count": 5
        }
      }
    },
    {
      "name": "carries firewall_id, labels, and taints into the body",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "confirm": true,
        "count": 5,
        "firewall_id": 88,
        "labels": {
          "tier": "app"
        },
        "taints": [
          {
            "key": "dedicated",
            "value": "app",
            "effect": "NoSchedule"
          }
        ]
      },
      "api_response": {
        "id": 7,
        "cluster_id": 12345,
        "count": 5
      },
      "expect_request": {
        "method": "PUT",
        "path": "/lke/clusters/12345/pools/7",
        "body": {
          "count": 5,
          "firewall_id": 88,
          "labels": {
            "tier": "app"
          },
          "taints": [
            {
              "key": "dedicated",
              "value": "app",
              "effect": "NoSchedule"
            }
          ]
        }
      }
    },
    {
      "name": "rejects a labels value that is not an object",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "confirm": true,
        "labels": 5
      },
      "expect_error": "labels must be an object"
    },
    {
      "name": "rejects a labels member that is not a string",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "confirm": true,
        "labels": {
          "tier": 5
        }
      },
      "expect_error": "labels values must be strings"
    },
    {
      "name": "rejects a taints value that is not an array of objects",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "confirm": true,
        "taints": "none"
      },
      "expect_error": "taints must be an array of objects"
    },
    {
      "name": "rejects a non-positive firewall_id",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "confirm": true,
        "firewall_id": 0
      },
      "expect_error": "firewall_id must be an integer greater than or equal to 1"
    },
    {
      "name": "rejects a non-object API response",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "count": 5,
        "confirm": true
      },
      "api_response": 7,
      "expect_api_error": "node pool"
    }
  ]
}
