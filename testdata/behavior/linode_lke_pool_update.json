{
  "tool": "linode_lke_pool_update",
  "description": "Pins the cluster_id/pool_id-required rejections (checked in order) and the confirmed PUT with a minimal count body. The confirm-required text diverges (see report), so that case is reported, not pinned. A response that is not a JSON object must fail rather than yield a zeroed pool; the bare-array shape of that case is withheld because Python still fabricates a success from it (see report).",
  "cases": [
    {
      "name": "rejects missing cluster_id",
      "args": {},
      "expect_error": "cluster_id is required"
    },
    {
      "name": "rejects missing pool_id",
      "args": {
        "cluster_id": 12345
      },
      "expect_error": "pool_id is required"
    },
    {
      "name": "updates a node pool count",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "count": 5,
        "confirm": true
      },
      "api_response": {
        "id": 7,
        "count": 5
      },
      "expect_request": {
        "method": "PUT",
        "path": "/lke/clusters/12345/pools/7",
        "body": {
          "count": 5
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "count": 5
      },
      "expect_error": "This modifies the node pool configuration. Set confirm=true to proceed."
    },
    {
      "name": "rejects a non-object API response",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "count": 5,
        "confirm": true
      },
      "api_response": 7,
      "expect_api_error": "node pool"
    },
    {
      "name": "carries firewall_id, labels, and taints into the body",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "confirm": true,
        "count": 5,
        "firewall_id": 88,
        "labels": {
          "tier": "app"
        },
        "taints": [
          {
            "key": "dedicated",
            "value": "app",
            "effect": "NoSchedule"
          }
        ]
      },
      "api_response": {
        "id": 7,
        "cluster_id": 12345,
        "count": 5
      },
      "expect_request": {
        "method": "PUT",
        "path": "/lke/clusters/12345/pools/7",
        "body": {
          "count": 5,
          "firewall_id": 88,
          "labels": {
            "tier": "app"
          },
          "taints": [
            {
              "key": "dedicated",
              "value": "app",
              "effect": "NoSchedule"
            }
          ]
        }
      }
    },
    {
      "name": "rejects a labels value that is not an object",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "confirm": true,
        "labels": 5
      },
      "expect_error": "labels must be an object"
    },
    {
      "name": "rejects a taints value that is not an array of objects",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "confirm": true,
        "taints": "none"
      },
      "expect_error": "taints must be an array of objects"
    },
    {
      "name": "rejects a non-positive firewall_id",
      "args": {
        "cluster_id": 12345,
        "pool_id": 7,
        "confirm": true,
        "firewall_id": 0
      },
      "expect_error": "firewall_id must be an integer greater than or equal to 1"
    }
  ]
}
