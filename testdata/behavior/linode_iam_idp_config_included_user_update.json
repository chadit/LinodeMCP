{
  "tool": "linode_iam_idp_config_included_user_update",
  "description": "Included user replace. The route answers with the resulting page rather than the resource it changed, and the empty list is the documented way to clear the inclusions.",
  "cases": [
    {
      "name": "rejects a blank idp_config_id",
      "args": {
        "idp_config_id": "  ",
        "usernames": [
          "adevlin"
        ],
        "confirm": true
      },
      "expect_error": "idp_config_id is required"
    },
    {
      "name": "rejects a blank username entry",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "   "
        ],
        "confirm": true
      },
      "expect_error": "usernames entries must not be blank"
    },
    {
      "name": "requires confirm",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "adevlin"
        ]
      },
      "expect_error": "This replaces the single sign-on included user list. Set confirm=true to proceed."
    },
    {
      "name": "replaces the included users",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "adevlin"
        ],
        "confirm": true
      },
      "api_response": {
        "data": [
          {
            "id": "adevlin",
            "label": "adevlin",
            "type": "user",
            "url": "/v4/account/users/adevlin"
          }
        ],
        "page": 1,
        "pages": 1,
        "results": 1
      },
      "expect_request": {
        "method": "PUT",
        "path": "/iam/idp-configs/b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b/users-included",
        "api_surface": "v4beta",
        "body": {
          "usernames": [
            "adevlin"
          ]
        }
      }
    },
    {
      "name": "sends the empty list that clears the inclusions",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [],
        "confirm": true
      },
      "api_response": {
        "data": [],
        "page": 1,
        "pages": 1,
        "results": 0
      },
      "expect_request": {
        "method": "PUT",
        "path": "/iam/idp-configs/b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b/users-included",
        "api_surface": "v4beta",
        "body": {
          "usernames": []
        }
      }
    },
    {
      "name": "returns the users from the page envelope",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "adevlin"
        ],
        "confirm": true
      },
      "api_response": {
        "data": [
          {
            "id": "adevlin",
            "label": "adevlin",
            "type": "user",
            "url": "/v4/account/users/adevlin"
          }
        ],
        "page": 1,
        "pages": 1,
        "results": 1
      },
      "expect_result": {
        "count": 1,
        "users": [
          {
            "id": "adevlin",
            "label": "adevlin",
            "type": "user",
            "url": "/v4/account/users/adevlin"
          }
        ]
      }
    },
    {
      "name": "rejects a null API response",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "adevlin"
        ],
        "confirm": true
      },
      "api_response": null,
      "expect_api_error": "response"
    },
    {
      "name": "accepts null data as an empty page",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [],
        "confirm": true
      },
      "api_response": {
        "data": null,
        "page": 1,
        "pages": 1,
        "results": 0
      },
      "expect_result": {
        "count": 0,
        "users": []
      }
    },
    {
      "name": "previews the included user replacement",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "usernames": [
          "adevlin"
        ],
        "confirm": true,
        "dry_run": true
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_iam_idp_config_included_user_update",
        "would_execute": {
          "method": "PUT",
          "path": "/v4beta/iam/idp-configs/b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b/users-included",
          "body": {
            "usernames": [
              "adevlin"
            ]
          }
        },
        "current_state": null,
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    }
  ]
}
