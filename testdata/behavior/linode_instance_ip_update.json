{
  "tool": "linode_instance_ip_update",
  "description": "RDNS update needs confirm; PUTs the rdns body. An explicit null travels as null, which is how the API spells 'clear the reverse DNS'. No-confirm message text diverges (see report). Both languages check confirm before parsing, so the fixtured rejections carry confirm. A success body that is not a JSON object must fail rather than turn into a zeroed ip record; the two languages word that failure differently, so only the subject is shared.",
  "cases": [
    {
      "name": "rejects missing linode_id once confirmed",
      "args": { "confirm": true },
      "expect_error": "linode_id must be a positive integer"
    },
    {
      "name": "rejects a linode_id below one",
      "args": { "confirm": true, "linode_id": 0, "address": "203.0.113.5", "rdns": "host.example.com" },
      "expect_error": "linode_id must be a positive integer"
    },
    {
      "name": "rejects a blank address",
      "args": { "confirm": true, "linode_id": 123, "address": "   ", "rdns": "host.example.com" },
      "expect_error": "address is required"
    },
    {
      "name": "rejects an address that is not an IP literal",
      "args": { "confirm": true, "linode_id": 123, "address": "host.example.com", "rdns": "host.example.com" },
      "expect_error": "address must be a valid IP address"
    },
    {
      "name": "rejects missing rdns once confirmed",
      "args": { "confirm": true, "linode_id": 123, "address": "203.0.113.5" },
      "expect_error": "rdns is required"
    },
    {
      "name": "updates RDNS with the rdns body",
      "args": {
        "linode_id": 123,
        "address": "203.0.113.5",
        "rdns": "host.example.com",
        "confirm": true
      },
      "api_response": { "address": "203.0.113.5" },
      "expect_request": {
        "method": "PUT",
        "path": "/linode/instances/123/ips/203.0.113.5",
        "body": { "rdns": "host.example.com" }
      }
    },
    {
      "name": "sends an explicit null to clear the reverse DNS",
      "args": {
        "linode_id": 123,
        "address": "203.0.113.5",
        "rdns": null,
        "confirm": true
      },
      "api_response": { "address": "203.0.113.5" },
      "expect_request": {
        "method": "PUT",
        "path": "/linode/instances/123/ips/203.0.113.5",
        "body": { "rdns": null }
      }
    },
    {
      "name": "updates an IPv6 address the same way",
      "args": {
        "linode_id": 123,
        "address": "2600:3c03::f03c:91ff:fe24:3a2f",
        "rdns": "host.example.com",
        "confirm": true
      },
      "api_response": { "address": "2600:3c03::f03c:91ff:fe24:3a2f" },
      "expect_request": {
        "method": "PUT",
        "path": "/linode/instances/123/ips/2600:3c03::f03c:91ff:fe24:3a2f",
        "body": { "rdns": "host.example.com" }
      }
    },
    {
      "name": "rejects an rdns that is neither a string nor null",
      "args": { "linode_id": 123, "address": "203.0.113.5", "rdns": 7, "confirm": true },
      "expect_error": "rdns must be a string or null"
    },
    {
      "name": "requires confirm",
      "args": {"linode_id": 123, "address": "203.0.113.5", "rdns": "host.example.com"},
      "expect_error": "This updates reverse DNS for the IP address. Set confirm=true to proceed."
    },
    {
      "name": "dry_run_preview",
      "args": {
        "linode_id": 123,
        "address": "203.0.113.5",
        "rdns": "host.example.com",
        "dry_run": true
      },
      "api_responses": {
        "GET /linode/instances/123/ips/203.0.113.5": {
          "address": "",
          "gateway": "",
          "linode_id": 0,
          "prefix": 0,
          "public": false,
          "rdns": "",
          "region": "",
          "subnet_mask": "",
          "type": ""
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_instance_ip_update",
        "would_execute": {
          "method": "PUT",
          "path": "/linode/instances/123/ips/203.0.113.5",
          "body": { "rdns": "host.example.com" }
        },
        "current_state": {
          "address": "",
          "gateway": "",
          "linode_id": 0,
          "prefix": 0,
          "public": false,
          "rdns": "",
          "region": "",
          "subnet_mask": "",
          "type": ""
        },
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    },
    {
      "name": "rejects a numeric API response",
      "args": { "linode_id": 123, "address": "203.0.113.5", "rdns": "host.example.com", "confirm": true },
      "api_response": 7,
      "expect_api_error": "IP"
    },
    {
      "name": "rejects a boolean API response",
      "args": { "linode_id": 123, "address": "203.0.113.5", "rdns": "host.example.com", "confirm": true },
      "api_response": true,
      "expect_api_error": "IP"
    },
    {
      "name": "rejects a populated-array API response",
      "args": { "linode_id": 123, "address": "203.0.113.5", "rdns": "host.example.com", "confirm": true },
      "api_response": [1, 2],
      "expect_api_error": "IP"
    }
  ]
}
