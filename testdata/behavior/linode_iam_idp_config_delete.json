{
  "tool": "linode_iam_idp_config_delete",
  "description": "Destroy tool addressed by a UUID string. The preview case is what proves the synthesized state fetch: the tool declares no fetch_state hook, so both languages read the configuration through linode_iam_idp_config_get, the sibling declared on the same route, and report it as that read's own message.",
  "cases": [
    {
      "name": "rejects a blank idp_config_id",
      "args": {
        "idp_config_id": "   ",
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "expect_error": "idp_config_id is required"
    },
    {
      "name": "confirm alone hits the destroy gate",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "confirm": true
      },
      "expect_error": "linode_iam_idp_config_delete is destructive. Either:\n  1. Call with dry_run: true first to preview, then call again with\n     confirm: true, confirmed_dry_run: true\n  2. Call with confirm: true, confirm_bypass_dry_run: true to skip preview\n  3. Use yolo: true (only if profile allows)"
    },
    {
      "name": "deletes the IDP configuration",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "api_response": {},
      "expect_request": {
        "method": "DELETE",
        "path": "/iam/idp-configs/b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "api_surface": "v4beta"
      }
    },
    {
      "name": "dry_run_preview",
