{
  "tool": "linode_image_sharegroup_by_token_get",
  "description": "Pins the token_uuid rejections and the token-to-sharegroup GET.",
  "cases": [
    {
      "name": "rejects missing token_uuid",
      "args": {},
      "expect_error": "token_uuid must be a non-empty string"
    },
    {
      "name": "rejects a token carrying a path separator",
      "args": {
        "token_uuid": "tokens/123e4567-e89b-12d3-a456-426614174000"
      },
      "expect_error": "token_uuid must not contain path separators, query separators, fragments, or traversal segments"
    },
    {
      "name": "rejects a non-canonical uuid",
      "args": {
        "token_uuid": "123e4567e89b12d3a456426614174000"
      },
      "expect_error": "token_uuid must be a UUID"
    },
    {
      "name": "gets the share group for a token",
      "args": {
        "token_uuid": "123e4567-e89b-12d3-a456-426614174000"
      },
      "api_response": {},
      "expect_request": {
        "method": "GET",
        "path": "/images/sharegroups/tokens/123e4567-e89b-12d3-a456-426614174000/sharegroup"
      }
    },
    {
      "name": "preserves documented explicit nulls",
      "args": {
        "token_uuid": "11111111-1111-1111-1111-111111111111"
      },
      "api_response": {
        "id": 3,
        "uuid": "22222222-2222-2222-2222-222222222222",
        "label": "share",
        "description": null,
        "is_suspended": false,
        "created": "2026-01-01T00:00:00",
        "updated": null,
        "expiry": null,
        "images_count": 0,
        "members_count": 0
      },
      "expect_result": {
        "id": 3,
        "uuid": "22222222-2222-2222-2222-222222222222",
        "label": "share",
        "description": null,
        "is_suspended": false,
        "created": "2026-01-01T00:00:00",
        "updated": null,
        "expiry": null,
        "images_count": 0,
        "members_count": 0
      }
    }
  ]
}
