{
  "tool": "linode_monitor_alert_channel_delete",
  "description": "Destroy tool. The preview case is what proves the synthesized state fetch: the tool declares no fetch_state hook, so both languages read the channel through linode_monitor_alert_channel_get, the sibling declared on the same route, and report it as that read's own message. The preview state also pins alerts as one summary object rather than a list.",
  "cases": [
    {
      "name": "rejects a non-positive channel_id",
      "args": {
        "channel_id": 0,
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "expect_error": "channel_id must be a positive integer"
    },
    {
      "name": "refuses a fractional channel_id rather than truncating it",
      "args": {
        "channel_id": 5.7,
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "expect_error": "channel_id must be a positive integer"
    },
    {
      "name": "confirm alone hits the destroy gate",
      "args": {
        "channel_id": 42,
        "confirm": true
      },
      "expect_error": "linode_monitor_alert_channel_delete is destructive. Either:\n  1. Call with dry_run: true first to preview, then call again with\n     confirm: true, confirmed_dry_run: true\n  2. Call with confirm: true, confirm_bypass_dry_run: true to skip preview\n  3. Use yolo: true (only if profile allows)"
    },
    {
      "name": "deletes the monitor alert channel",
      "args": {
        "channel_id": 42,
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "api_response": {},
      "expect_request": {
        "method": "DELETE",
        "path": "/monitor/alert-channels/42"
      }
    },
    {
      "name": "dry_run_preview",
      "args": {
        "channel_id": 42,
        "dry_run": true
      },
      "api_responses": {
        "GET /monitor/alert-channels/42": {
          "id": 42,
          "label": "oncall email",
          "type": "alert-channel",
          "channel_type": "email",
          "content": {
            "email": {
              "email_addresses": [
                "oncall@example.com"
              ]
            }
          },
          "alerts": {
            "alert_count": 2,
            "type": "alert-definition",
            "url": "/v4beta/monitor/alert-channels/42/alerts"
          },
          "created": "2026-01-02T03:04:05",
          "created_by": "someuser",
          "updated": "2026-01-03T04:05:06",
          "updated_by": "someuser",
          "details": {
            "email": {
              "recipient_type": "user",
              "usernames": [
                "someuser"
              ]
            }
          }
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_monitor_alert_channel_delete",
        "would_execute": {
          "method": "DELETE",
          "path": "/monitor/alert-channels/42"
        },
        "current_state": {
          "id": 42,
          "label": "oncall email",
          "type": "alert-channel",
          "channel_type": "email",
          "content": {
            "email": {
              "email_addresses": [
                "oncall@example.com"
              ]
            }
          },
          "alerts": {
            "alert_count": 2,
            "type": "alert-definition",
            "url": "/v4beta/monitor/alert-channels/42/alerts"
          },
          "created": "2026-01-02T03:04:05",
          "created_by": "someuser",
          "updated": "2026-01-03T04:05:06",
          "updated_by": "someuser",
          "details": {
            "email": {
              "recipient_type": "user",
              "usernames": [
                "someuser"
              ]
            }
          }
        },
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    }
  ]
}
