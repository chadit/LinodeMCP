{
  "tool": "linode_profile_draft_save",
  "description": "CapMeta builder tool writing a draft into the config file (no Linode API call). Pins every refusal that answers before the file is touched, in the order the handler asks them (name, confirm, built-in name, registry lookup), and the success path. The success case runs in the stateful lane, where the config path is redirected into a directory the case owns, so it writes a real file without reaching the operator's own config.",
  "cases": [
    {
      "name": "refuses an absent name",
      "args": {
        "confirm": true
      },
      "expect_error": "name argument is required"
    },
    {
      "name": "refuses without confirm",
      "args": {
        "name": "seam-fixture"
      },
      "expect_error": "confirm=true is required for draft save"
    },
    {
      "name": "refuses a built-in profile name",
      "args": {
        "name": "default",
        "confirm": true
      },
      "expect_error": "cannot save over built-in profile name: default"
    },
    {
      "name": "refuses a name no draft carries",
      "args": {
        "name": "no-such-draft",
        "confirm": true
      },
      "expect_error": "draft not found: no-such-draft"
    },
    {
      "name": "writes a new profile and answers the diff",
      "setup_calls": [
        {
          "tool": "linode_profile_draft_new",
          "args": {
            "name": "seam-fixture"
          }
        },
        {
          "tool": "linode_profile_draft_add_tools",
          "args": {
            "name": "seam-fixture",
            "tools": [
              "linode_vlan_list",
              "linode_region_list"
            ]
          }
        },
        {
          "tool": "linode_profile_draft_set",
          "args": {
            "name": "seam-fixture",
            "allowed_environments": [
              "staging"
            ],
            "allow_yolo": true
          }
        }
      ],
      "args": {
        "name": "seam-fixture",
        "confirm": true
      },
      "expect_result": {
        "name": "seam-fixture",
        "is_new": true,
        "added_tools": [
          "linode_region_list",
          "linode_vlan_list"
        ],
        "removed_tools": [],
        "changed_fields": {
          "allow_yolo": {
            "old": false,
            "new": true
          },
          "allowed_environments": {
            "old": [],
            "new": [
              "staging"
            ]
          }
        }
      }
    }
  ]
}
