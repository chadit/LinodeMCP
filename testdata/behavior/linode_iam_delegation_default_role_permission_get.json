{
  "tool": "linode_iam_delegation_default_role_permission_get",
  "description": "Gets the role assignment delegate users receive by default. The route answers with two collections and no count, so the tool serializes one resource rather than a page.",
  "cases": [
    {
      "name": "gets the default assignment",
      "args": {},
      "api_response": {
        "account_access": ["account_linode_creator", "account_firewall_creator"],
        "entity_access": [
          { "id": 1, "type": "linode", "roles": ["linode_contributor"] },
          { "id": 4, "type": "firewall", "roles": ["firewall_viewer"] }
        ]
      },
      "expect_request": {
        "method": "GET",
        "path": "/iam/delegation/default-role-permissions"
      }
    },
    {
      "name": "gets a default assignment granting nothing",
      "args": {},
      "api_response": { "account_access": [], "entity_access": [] },
      "expect_request": {
        "method": "GET",
        "path": "/iam/delegation/default-role-permissions"
      }
    }
  ]
}
