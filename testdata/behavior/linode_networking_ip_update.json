{
  "tool": "linode_networking_ip_update",
  "description": "Networking IP update PUTs the rdns change once confirmed. The address is checked before the rdns value so a call naming neither reports the address, and the dry run reads the address so a caller sees the reverse DNS being replaced.",
  "cases": [
    {
      "name": "requires confirm",
      "args": {
        "address": "203.0.113.5",
        "rdns": "host.example.com"
      },
      "expect_error": "This updates reverse DNS for an IP address. Set confirm=true to proceed."
    },
    {
      "name": "requires an address",
      "args": { "confirm": true, "rdns": "host.example.com" },
      "expect_error": "address must be a non-empty string"
    },
    {
      "name": "rejects a malformed address once confirmed",
      "args": {
        "confirm": true,
        "address": "not-an-ip",
        "rdns": "host.example.com"
      },
      "expect_error": "address must be a valid IP address"
    },
    {
      "name": "requires rdns",
      "args": { "confirm": true, "address": "203.0.113.5" },
      "expect_error": "rdns is required"
    },
    {
      "name": "rejects a non-string rdns",
      "args": { "confirm": true, "address": "203.0.113.5", "rdns": 7 },
      "expect_error": "rdns must be a string"
    },
    {
      "name": "rejects a non-boolean reserved",
      "args": {
        "confirm": true,
        "address": "203.0.113.5",
        "rdns": "host.example.com",
        "reserved": "yes"
      },
      "expect_error": "reserved must be a boolean"
    },
    {
      "name": "updates reverse DNS",
      "args": {
        "confirm": true,
        "address": "203.0.113.5",
        "rdns": "host.example.com"
      },
      "api_response": {},
      "expect_request": {
        "method": "PUT",
        "path": "/networking/ips/203.0.113.5",
        "body": {
          "rdns": "host.example.com"
        }
      }
    },
    {
      "name": "carries the reserved flag into the body",
      "args": {
        "confirm": true,
        "address": "203.0.113.5",
        "rdns": "host.example.com",
        "reserved": true
      },
      "api_response": {
        "address": "203.0.113.5",
        "rdns": "host.example.com"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/networking/ips/203.0.113.5",
        "body": {
          "rdns": "host.example.com",
          "reserved": true
        }
      }
    },
    {
      "name": "sends an explicit false reserved",
      "args": {
        "confirm": true,
        "address": "203.0.113.5",
        "rdns": "host.example.com",
        "reserved": false
      },
      "api_response": {
        "address": "203.0.113.5",
        "rdns": "host.example.com"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/networking/ips/203.0.113.5",
        "body": {
          "rdns": "host.example.com",
          "reserved": false
        }
      }
    },
    {
      "name": "reports the updated address",
      "args": {
        "confirm": true,
        "address": "203.0.113.5",
        "rdns": "host.example.com"
      },
      "api_response": {
        "address": "203.0.113.5",
        "gateway": "203.0.113.1",
        "subnet_mask": "255.255.255.0",
        "prefix": 24,
        "type": "ipv4",
        "public": true,
        "rdns": "host.example.com",
        "linode_id": 123,
        "region": "us-east"
      },
      "expect_result": {
        "message": "Networking IP 203.0.113.5 RDNS updated",
        "ip": {
          "address": "203.0.113.5",
          "gateway": "203.0.113.1",
          "subnet_mask": "255.255.255.0",
          "prefix": 24,
          "type": "ipv4",
          "public": true,
          "rdns": "host.example.com",
          "linode_id": 123,
          "region": "us-east"
        }
      }
    },
    {
      "name": "rejects a non-object API response",
      "args": {
        "confirm": true,
        "address": "203.0.113.5",
        "rdns": "host.example.com"
      },
      "api_response": 7,
      "expect_api_error": "networking ip update response must be a JSON object"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "dry_run": true,
        "address": "203.0.113.5",
        "rdns": "host.example.com"
      },
      "api_responses": {
        "GET /networking/ips/203.0.113.5": {
          "address": "203.0.113.5",
          "gateway": "203.0.113.1",
          "subnet_mask": "255.255.255.0",
          "prefix": 24,
          "type": "ipv4",
          "public": true,
          "rdns": "old.example.com",
          "linode_id": 123,
          "region": "us-east"
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_networking_ip_update",
        "would_execute": {
          "method": "PUT",
          "path": "/networking/ips/203.0.113.5",
          "body": {
            "rdns": "host.example.com"
          }
        },
        "current_state": {
          "address": "203.0.113.5",
          "gateway": "203.0.113.1",
          "subnet_mask": "255.255.255.0",
          "prefix": 24,
          "type": "ipv4",
          "public": true,
          "rdns": "old.example.com",
          "linode_id": 123,
          "region": "us-east"
        },
        "dependencies": [],
        "side_effects": ["Reverse DNS (rDNS) is set to \"host.example.com\"."],
        "warnings": []
      }
    }
  ]
}
