{
  "tool": "linode_lke_dashboard_get",
  "description": "Pins the cluster_id rejections and the single GET. cluster_id is an integer path param.",
  "cases": [
    {
      "name": "rejects missing cluster_id",
      "args": {},
      "expect_error": "cluster_id is required"
    },
    {
      "name": "rejects a non-positive cluster_id",
      "args": {
        "cluster_id": 0
      },
      "expect_error": "cluster_id must be a positive integer"
    },
    {
      "name": "gets the dashboard url",
      "args": {
        "cluster_id": 12345
      },
      "api_response": {
        "url": "https://dashboard.example"
      },
      "expect_request": {
        "method": "GET",
        "path": "/lke/clusters/12345/dashboard"
      }
    }
  ]
}
