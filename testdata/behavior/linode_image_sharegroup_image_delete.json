{
  "tool": "linode_image_sharegroup_image_delete",
  "description": "Destroy tool. The route addresses the shared image by its shared/N slug, the same value the sibling PUT takes. Pins the sharegroup_id rejection, the numeric-id refusal, the slug-shape refusal the sibling PUT already answers, the confirm-alone destroy gate, and the bypassed DELETE.",
  "cases": [
    {
      "name": "rejects missing sharegroup_id",
      "args": {
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "expect_error": "sharegroup_id is required"
    },
    {
      "name": "rejects a numeric image_id",
      "args": {
        "sharegroup_id": 5,
        "image_id": 7,
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "expect_error": "image_id is required"
    },
    {
      "name": "rejects an image_id that is not a shared slug",
      "args": {
        "sharegroup_id": 5,
        "image_id": "7",
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "expect_error": "image_id must match shared/<positive integer>"
    },
    {
      "name": "confirm alone hits the destroy gate on a shared slug",
      "args": {
        "sharegroup_id": 5,
        "image_id": "shared/7",
        "confirm": true
      },
      "expect_error": "linode_image_sharegroup_image_delete is destructive. Either:\n  1. Call with dry_run: true first to preview, then call again with\n     confirm: true, confirmed_dry_run: true\n  2. Call with confirm: true, confirm_bypass_dry_run: true to skip preview\n  3. Use yolo: true (only if profile allows)"
    },
    {
      "name": "removes the shared image by slug",
      "args": {
        "sharegroup_id": 5,
        "image_id": "shared/7",
        "confirm": true,
        "confirm_bypass_dry_run": true
      },
      "api_response": {},
      "expect_request": {
        "method": "DELETE",
        "path": "/images/sharegroups/5/images/shared%2F7"
      }
    },
    {
      "name": "dry_run_preview_shared_slug",
      "args": {
        "sharegroup_id": 5,
        "image_id": "shared/7",
        "dry_run": true
      },
      "api_responses": {
        "GET /images/sharegroups/5": {
          "created": "",
          "description": null,
          "expiry": null,
          "id": 0,
          "images_count": 0,
          "is_suspended": false,
          "label": "",
          "members_count": 0,
          "updated": null,
          "uuid": ""
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_image_sharegroup_image_delete",
        "would_execute": {
          "method": "DELETE",
          "path": "/images/sharegroups/5/images/shared%2F7"
        },
        "current_state": {
          "created": "",
          "description": null,
          "expiry": null,
          "id": 0,
          "images_count": 0,
          "is_suspended": false,
          "label": "",
          "members_count": 0,
          "updated": null,
          "uuid": ""
        },
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    }
  ]
}
