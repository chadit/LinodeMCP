{
  "tool": "linode_database_valkey_instance_patch",
  "description": "Instance-id validation (with confirm, both languages agree), the confirm-gated patch POST, and the dry-run preview. The patch declares one preview sentence, so warnings stay empty. The dry-run state body leaves engine version and replication type blank: TechDocs documents neither for Valkey.",
  "cases": [
    {
      "name": "rejects non-positive instance_id",
      "args": {
        "instance_id": 0,
        "confirm": true
      },
      "expect_error": "instance_id must be a positive integer"
    },
    {
      "name": "patches a valkey instance",
      "args": {
        "instance_id": 123,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/databases/valkey/instances/123/patch"
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "instance_id": 123
      },
      "expect_error": "This patches a Valkey Managed Database instance. Set confirm=true to proceed."
    },
    {
      "name": "dry_run_preview",
      "args": {
        "instance_id": 123,
        "dry_run": true
      },
