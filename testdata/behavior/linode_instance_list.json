{
  "tool": "linode_instance_list",
  "description": "Pins the unfiltered list GET, the shared pagination rejections, and the query string both languages must build. Status filtering stays client-side.",
  "cases": [
    {
      "name": "rejects non-integer page",
      "args": { "page": "x" },
      "expect_error": "page must be an integer"
    },
    {
      "name": "rejects non-integer page_size",
      "args": { "page_size": "x" },
      "expect_error": "page_size must be an integer"
    },
    {
      "name": "rejects an environment that is not a name",
      "args": { "environment": 5 },
      "expect_error": "environment not found in configuration: 5"
    },
    {
      "name": "rejects an environment the config does not name",
      "args": { "environment": "staging" },
      "expect_error": "environment not found in configuration: staging"
    },
    {
      "name": "lists instances",
      "args": {},
      "api_response": { "data": [], "page": 1, "pages": 1, "results": 0 },
      "expect_request": { "method": "GET", "path": "/linode/instances" }
    },
    {
      "name": "pagination reaches the request",
      "args": { "page": 2, "page_size": 50 },
      "api_response": { "data": [], "page": 2, "pages": 2, "results": 0 },
      "expect_request": {
        "method": "GET",
        "path": "/linode/instances?page=2&page_size=50"
      }
    }
  ]
}
