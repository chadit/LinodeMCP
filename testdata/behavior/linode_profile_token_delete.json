{
  "tool": "linode_profile_token_delete",
  "description": "Revokes a personal access token with a single DELETE once confirmed. Missing-token_id rejection text diverges (see report).",
  "cases": [
    {
      "name": "rejects non-positive token_id",
      "args": {
        "token_id": 0,
        "confirm": true
      },
      "expect_error": "token_id must be a positive integer"
    },
    {
      "name": "revokes a personal access token",
      "args": {
        "token_id": 123,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "DELETE",
        "path": "/profile/tokens/123"
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "token_id": 123
      },
      "expect_error": "This revokes a personal access token. Set confirm=true to proceed."
    },
    {
      "name": "dry_run_preview",
      "args": {
        "token_id": 123,
        "dry_run": true
      },
      "api_responses": {
        "GET /profile/tokens/123": {
          "id": 123,
          "label": "ci-token",
          "scopes": "linodes:read_only",
          "created": "2024-05-01T00:01:01",
          "expiry": "2024-06-01T00:01:01"
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_profile_token_delete",
        "would_execute": {
          "method": "DELETE",
          "path": "/profile/tokens/123"
        },
        "current_state": {
          "id": 123,
          "label": "ci-token",
          "scopes": "linodes:read_only",
          "created": "2024-05-01T00:01:01",
          "expiry": "2024-06-01T00:01:01"
        },
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    }
  ]
}
