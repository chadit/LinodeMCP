{
  "tool": "linode_instance_interface_settings_update",
  "description": "Pins the shared no-field rejection, the typed default_route reader's sentences, and the interface-settings update PUT body. The preview reads the settings the call would replace, which is the union of what the two languages used to answer.",
  "cases": [
    {
      "name": "rejects missing network_helper and default_route",
      "args": {
        "linode_id": 123,
        "confirm": true
      },
      "expect_error": "network_helper or default_route is required"
    },
    {
      "name": "updates network helper",
      "args": {
        "linode_id": 123,
        "confirm": true,
        "network_helper": true
      },
      "api_response": {},
      "expect_request": {
        "method": "PUT",
        "path": "/linode/instances/123/interfaces/settings",
        "body": {
          "network_helper": true
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "linode_id": 123,
        "network_helper": true
      },
      "expect_error": "This updates interface settings for the Linode instance. Set confirm=true to proceed."
    },
    {
      "name": "rejects a default_route that is not an object",
      "args": {
        "linode_id": 123,
        "confirm": true,
        "default_route": 7
      },
      "expect_error": "default_route must be an object"
    },
    {
      "name": "rejects a default_route member that is not an integer",
      "args": {
        "linode_id": 123,
        "confirm": true,
        "default_route": {
          "ipv4_interface_id": "four"
        }
      },
      "expect_error": "default_route.ipv4_interface_id must be an integer"
    },
    {
      "name": "rejects a default_route member that is not positive",
      "args": {
        "linode_id": 123,
        "confirm": true,
        "default_route": {
          "ipv6_interface_id": 0
        }
      },
      "expect_error": "default_route.ipv6_interface_id must be a positive integer"
    },
    {
      "name": "rejects a negative default_route member",
      "args": {
        "linode_id": 123,
        "confirm": true,
        "default_route": {
          "ipv4_interface_id": -1
        }
      },
      "expect_error": "default_route.ipv4_interface_id must be a positive integer"
    },
    {
      "name": "rejects an empty default_route",
      "args": {
        "linode_id": 123,
        "confirm": true,
        "default_route": {}
      },
      "expect_error": "default_route must include ipv4_interface_id or ipv6_interface_id"
    },
    {
      "name": "rejects a default_route whose members are all absent",
      "args": {
        "linode_id": 123,
        "confirm": true,
        "default_route": {
          "ipv4_interface_id": null
        }
      },
      "expect_error": "default_route must include ipv4_interface_id or ipv6_interface_id"
    },
    {
      "name": "rejects a default_route field the message does not declare",
      "args": {
        "linode_id": 123,
        "confirm": true,
        "default_route": {
          "ipv4_interface_id": 4,
          "ipv5_interface_id": 9
        }
      },
      "expect_error": "default_route has no field \"ipv5_interface_id\""
    },
    {
      "name": "rejects a non-boolean network_helper",
      "args": {
        "linode_id": 123,
        "confirm": true,
        "network_helper": "yes"
      },
      "expect_error": "network_helper must be a boolean"
    },
    {
      "name": "rejects a missing linode_id",
      "args": {
        "confirm": true,
        "network_helper": true
      },
      "expect_error": "linode_id must be a positive integer"
    },
    {
      "name": "sends the typed default_route",
      "args": {
        "linode_id": 123,
        "confirm": true,
        "default_route": {
          "ipv4_interface_id": 4,
          "ipv6_interface_id": 9
        }
      },
      "api_response": {},
      "expect_request": {
        "method": "PUT",
        "path": "/linode/instances/123/interfaces/settings",
        "body": {
          "default_route": {
            "ipv4_interface_id": 4,
            "ipv6_interface_id": 9
          }
        }
      }
    },
    {
      "name": "dry_run_preview",
      "args": {
        "linode_id": 123,
        "dry_run": true,
        "default_route": {
          "ipv4_interface_id": 7
        }
      },
      "api_responses": {
        "GET /linode/instances/123/interfaces/settings": {
          "default_route": {
            "ipv4_interface_id": 4
          },
          "network_helper": true
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_instance_interface_settings_update",
        "would_execute": {
          "method": "PUT",
          "path": "/linode/instances/123/interfaces/settings",
          "body": {
            "default_route": {
              "ipv4_interface_id": 7
            }
          }
        },
        "current_state": {
          "default_route": {
            "ipv4_interface_id": 4
          },
          "network_helper": true
        },
        "dependencies": [],
        "side_effects": [
          "Interface settings for Linode 123 will be updated."
        ],
        "warnings": []
      }
    }
  ]
}
