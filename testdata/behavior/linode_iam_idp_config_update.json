{
  "tool": "linode_iam_idp_config_update",
  "description": "IDP configuration update. The route changes only the members it is given, so a call naming none is refused here rather than sent as an empty body, and a saml sent at all has to be whole because it replaces the object.",
  "cases": [
    {
      "name": "rejects a blank idp_config_id",
      "args": {
        "idp_config_id": "  ",
        "label": "okta-prod",
        "confirm": true
      },
      "expect_error": "idp_config_id is required"
    },
    {
      "name": "rejects a call naming no update field",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "confirm": true
      },
      "expect_error": "at least one update field is required: label, saml, enabled, or enforce"
    },
    {
      "name": "rejects a saml with an unknown identity_element",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "saml": {
          "entity_id": "https://idp.example.com/saml/metadata",
          "identity_element": "EMAIL",
          "idp_url": "https://idp.example.com/sso/saml",
          "public_certificates": [
            {
              "certificate": "MIIDexampleCertificateData"
            }
          ]
        },
        "confirm": true
      },
      "expect_error": "saml.identity_element must be one of: NAME_ID, USER_ID_ATTRIBUTE"
    },
    {
      "name": "rejects a saml with no certificates",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "saml": {
          "entity_id": "https://idp.example.com/saml/metadata",
          "identity_element": "NAME_ID",
          "idp_url": "https://idp.example.com/sso/saml",
          "public_certificates": []
        },
        "confirm": true
      },
      "expect_error": "saml.public_certificates must include at least one certificate"
    },
    {
      "name": "requires confirm",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "enforce": true
      },
      "expect_error": "This changes the account's single sign-on configuration. Set confirm=true to proceed."
    },
    {
      "name": "puts only the members the caller named",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "label": "okta-prod-renamed",
        "enforce": true,
        "confirm": true
      },
      "api_response": {
        "created": "2026-03-04T12:00:00",
        "created_by": "jsmith",
        "enabled": true,
        "enforce": true,
        "excluded_users_count": 1,
        "id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "included_users_count": 0,
        "label": "okta-prod-renamed",
        "saml": {
          "entity_id": "https://idp.example.com/saml/metadata",
          "identity_element": "NAME_ID",
          "idp_url": "https://idp.example.com/sso/saml",
          "public_certificates": [
            {
              "certificate": "MIIDexampleCertificateData",
              "created": "2026-03-04T12:00:00",
              "created_by": "jsmith",
              "id": "1f2e3d4c-5b6a-4798-9c0d-2e3f4a5b6c7d",
              "not_after": "2027-03-04T12:00:00",
              "not_before": "2026-03-04T12:00:00"
            }
          ]
        },
        "updated": "2026-03-05T09:30:00",
        "updated_by": "jsmith"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/iam/idp-configs/b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "api_surface": "v4beta",
        "body": {
          "label": "okta-prod-renamed",
          "enforce": true
        }
      }
    },
    {
      "name": "rejects malformed success body",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "label": "okta-prod-renamed",
        "confirm": true
      },
      "api_response_raw": "not json",
      "expect_api_error": "line 1"
    },
    {
      "name": "previews the IDP configuration update request",
      "args": {
        "idp_config_id": "b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
        "enabled": false,
        "confirm": true,
        "dry_run": true
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_iam_idp_config_update",
        "would_execute": {
          "method": "PUT",
          "path": "/v4beta/iam/idp-configs/b7f5c1e2-0a3d-4f9b-8c21-5d6e7f809a1b",
          "body": {
            "enabled": false
          }
        },
        "current_state": null,
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    }
  ]
}
