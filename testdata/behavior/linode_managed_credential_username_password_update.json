{
  "tool": "linode_managed_credential_username_password_update",
  "description": "Credential username/password update (Admin): shared missing-id rejection and the confirmed POST body. Missing-password and confirm-gate text diverge (see report). Placeholder password kept short to stay out of the secret scanner.",
  "cases": [
    {
      "name": "rejects missing credential_id",
      "args": {
        "confirm": true
      },
      "expect_error": "credential_id must be a positive integer"
    },
    {
      "name": "updates a managed credential username and password",
      "args": {
        "credential_id": 5,
        "password": "pw",
        "username": "svc",
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/managed/credentials/5/update",
        "body": {
          "password": "pw",
          "username": "svc"
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "credential_id": 5,
        "password": "pw",
        "username": "svc"
      },
      "expect_error": "This updates a stored Managed credential's username and password. Set confirm=true to proceed."
    },
    {
      "name": "dry_run_preview",
      "args": {
        "credential_id": 5,
        "password": "pw",
        "username": "svc",
        "dry_run": true
      },
      "api_responses": {
        "GET /managed/credentials/5": {
          "label": "db",
          "last_decrypted": "",
          "id": 5
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_managed_credential_username_password_update",
        "would_execute": {
          "method": "POST",
          "path": "/managed/credentials/5/update",
          "body": {
            "password": {
              "redacted": true
            },
            "username": "svc"
          }
        },
        "current_state": {
          "label": "db",
          "last_decrypted": "",
          "id": 5
        },
        "dependencies": [],
        "side_effects": [
          "Managed credential 5 will be updated."
        ],
        "warnings": []
      }
    }
  ]
}
