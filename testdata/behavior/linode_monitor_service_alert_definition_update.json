{
  "tool": "linode_monitor_service_alert_definition_update",
  "description": "Update validates each present field locally before calling the API, and trims the label. entity_ids must be a non-empty array of non-blank strings on update (unlike create, where an empty array is accepted and omitted). A body that will not parse must fail rather than turn into a made-up record. The two languages frame the parse failure differently, so the shared assertion is the parser's position marker.",
  "cases": [
    {
      "name": "rejects integer entity ids",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "entity_ids": [
          1,
          2
        ],
        "confirm": true
      },
      "expect_error": "entity_ids must be an array of strings"
    },
    {
      "name": "rejects out-of-range severity",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "severity": 4,
        "confirm": true
      },
      "expect_error": "severity must be one of: 0, 1, 2, 3"
    },
    {
      "name": "puts the update body with trimmed label",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "label": "  cpu high  ",
        "entity_ids": [
          "1",
          "2"
        ],
        "confirm": true
      },
      "api_response": {
        "id": 42,
        "label": "cpu high"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/monitor/services/dbaas/alert-definitions/42",
        "body": {
          "label": "cpu high",
          "entity_ids": [
            "1",
            "2"
          ]
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "label": "cpu high",
        "entity_ids": [
          "1",
          "2"
        ]
      },
      "expect_error": "This updates a monitor alert definition. Set confirm=true to proceed."
    },
    {
      "name": "rejects malformed success body",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "label": "cpu high",
        "entity_ids": [
          "1",
          "2"
        ],
        "confirm": true
      },
      "api_response_raw": "not json",
      "expect_api_error": "line 1"
    },
    {
      "name": "rejects empty success body",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "label": "cpu high",
        "entity_ids": [
          "1",
          "2"
        ],
        "confirm": true
      },
      "api_response_raw": "",
      "expect_api_error": "line 1"
    },
    {
      "name": "carries group_by into the body",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "confirm": true,
        "group_by": [
          "region",
          "entity_id"
        ]
      },
      "api_response": {
        "id": 42,
        "label": "cpu high"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/monitor/services/dbaas/alert-definitions/42",
        "body": {
          "group_by": [
            "region",
            "entity_id"
          ]
        }
      }
    },
    {
      "name": "rejects a blank group_by entry",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "confirm": true,
        "group_by": [
          "  "
        ]
      },
      "expect_error": "group_by must be an array of non-empty strings"
    },
    {
      "name": "rejects an update with no fields",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "confirm": true
      },
      "expect_error": "at least one update field is required"
    },
    {
      "name": "rejects an unknown status",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "status": "paused",
        "confirm": true
      },
      "expect_error": "status must be enabled or disabled"
    },
    {
      "name": "trims the status before sending it",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "status": "  disabled  ",
        "confirm": true
      },
      "api_response": {
        "id": 42,
        "label": "Source CPU alert"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/monitor/services/dbaas/alert-definitions/42",
        "body": {
          "status": "disabled"
        }
      }
    },
    {
      "name": "previews the update request and the definition it changes",
      "args": {
        "service_type": "dbaas",
        "alert_id": 42,
        "label": "CPU high",
        "dry_run": true
      },
      "api_responses": {
        "GET /monitor/services/dbaas/alert-definitions/42": {
          "criteria": null,
          "description": "",
          "id": 42,
          "label": "Source CPU alert",
          "service_type": "dbaas",
          "severity": 1,
          "type": "user"
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_monitor_service_alert_definition_update",
        "would_execute": {
          "method": "PUT",
          "path": "/monitor/services/dbaas/alert-definitions/42",
          "body": {
            "label": "CPU high"
          }
        },
        "current_state": {
          "criteria": null,
          "description": "",
          "id": 42,
          "label": "Source CPU alert",
          "service_type": "dbaas",
          "severity": 1,
          "type": "user"
        },
        "dependencies": [],
        "side_effects": [],
        "warnings": []
      }
    }
  ]
}
