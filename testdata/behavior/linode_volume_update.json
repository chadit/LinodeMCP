{
  "tool": "linode_volume_update",
  "description": "Volume update: volume_id-required rejection both languages agree on (confirm set so both reach it), plus the label PUT. Confirm-gate text and the label-or-tags message diverge (see report). A success body that is not a JSON object must fail rather than turn into a zeroed volume record; the two languages word that failure differently, so only the subject is shared.",
  "cases": [
    {
      "name": "requires volume_id",
      "args": {
        "confirm": true
      },
      "expect_error": "volume_id must be a positive integer"
    },
    {
      "name": "rejects a negative volume_id",
      "args": {
        "confirm": true,
        "volume_id": -1,
        "label": "new-label"
      },
      "expect_error": "volume_id must be a positive integer"
    },
    {
      "name": "updates a volume label",
      "args": {
        "confirm": true,
        "volume_id": 123,
        "label": "new-label"
      },
      "api_response": {
        "id": 123,
        "label": "new-label"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/volumes/123",
        "body": {
          "label": "new-label"
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "volume_id": 123,
        "label": "new-label"
      },
      "expect_error": "This updates a block storage volume. Set confirm=true to proceed."
    },
    {
      "name": "rejects a numeric API response",
      "args": {
        "confirm": true,
        "volume_id": 123,
        "label": "new-label"
      },
      "api_response": 7,
      "expect_api_error": "volume"
    },
    {
      "name": "rejects a boolean API response",
      "args": {
        "confirm": true,
        "volume_id": 123,
        "label": "new-label"
      },
      "api_response": true,
      "expect_api_error": "volume"
    },
    {
      "name": "rejects a populated-array API response",
      "args": {
        "confirm": true,
        "volume_id": 123,
        "label": "new-label"
      },
      "api_response": [
        1,
        2
      ],
      "expect_api_error": "volume"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "volume_id": 123,
        "label": "renamed",
        "tags": [
          "prod"
        ],
        "dry_run": true
      },
      "api_responses": {
        "GET /volumes/123": {
          "id": 123,
          "label": "data",
          "status": "active",
          "size": 20,
          "region": "us-east",
          "linode_id": 456,
          "linode_label": "web",
          "filesystem_path": "/dev/disk/by-id/scsi-0Linode_Volume_data",
          "tags": [],
          "created": "",
          "updated": "",
          "hardware_type": "nvme"
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_volume_update",
        "would_execute": {
          "method": "PUT",
          "path": "/volumes/123"
        },
        "current_state": {
          "id": 123,
          "label": "data",
          "status": "active",
          "size": 20,
          "region": "us-east",
          "linode_id": 456,
          "linode_label": "web",
          "filesystem_path": "/dev/disk/by-id/scsi-0Linode_Volume_data",
          "tags": [],
          "created": "",
          "updated": "",
          "hardware_type": "nvme"
        },
        "dependencies": [],
        "side_effects": [
          "Label changes from \"data\" to \"renamed\".",
          "The volume's tag set is replaced with the provided tags."
        ],
        "warnings": []
      }
    },
    {
      "name": "dry_run_preview_without_tags",
      "args": {
        "volume_id": 123,
        "label": "renamed",
        "dry_run": true
      },
      "api_responses": {
        "GET /volumes/123": {
          "id": 123,
          "label": "data",
          "status": "active",
          "size": 20,
          "region": "us-east",
          "linode_id": 456,
          "linode_label": "web",
          "filesystem_path": "/dev/disk/by-id/scsi-0Linode_Volume_data",
          "tags": [],
          "created": "",
          "updated": "",
          "hardware_type": "nvme"
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_volume_update",
        "would_execute": {
          "method": "PUT",
          "path": "/volumes/123"
        },
        "current_state": {
          "id": 123,
          "label": "data",
          "status": "active",
          "size": 20,
          "region": "us-east",
          "linode_id": 456,
          "linode_label": "web",
          "filesystem_path": "/dev/disk/by-id/scsi-0Linode_Volume_data",
          "tags": [],
          "created": "",
          "updated": "",
          "hardware_type": "nvme"
        },
        "dependencies": [],
        "side_effects": [
          "Label changes from \"data\" to \"renamed\"."
        ],
        "warnings": []
      }
    }
  ]
}
