{
  "tool": "linode_vpc_subnet_get",
  "description": "VPC subnet get requires an integer vpc_id and subnet_id, then GETs the subnet.",
  "cases": [
    {
      "name": "rejects a non-positive vpc_id",
      "args": {
        "vpc_id": 0
      },
      "expect_error": "vpc_id must be a positive integer"
    },
    {
      "name": "requires vpc_id",
      "args": {},
      "expect_error": "vpc_id is required"
    },
    {
      "name": "requires subnet_id",
      "args": {
        "vpc_id": 5
      },
      "expect_error": "subnet_id is required"
    },
    {
      "name": "rejects a non-positive subnet_id",
      "args": {
        "vpc_id": 5,
        "subnet_id": 0
      },
      "expect_error": "subnet_id must be a positive integer"
    },
    {
      "name": "gets the subnet",
      "args": {
        "vpc_id": 5,
        "subnet_id": 7
      },
      "api_response": {},
      "expect_request": {
        "method": "GET",
        "path": "/vpcs/5/subnets/7"
      }
    }
  ]
}
