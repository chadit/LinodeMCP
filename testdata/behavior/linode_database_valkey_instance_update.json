{
  "tool": "linode_database_valkey_instance_update",
  "description": "Confirm-gated update PUT body. The dry-run case pins the full Tier B preview from docs/dry-run.md. Two cluster_size cases carry over from the PostgreSQL sibling. The region case is this family's own: TechDocs puts region on the Valkey PUT body and on neither the MySQL nor the PostgreSQL one, and sending it alone fails if region is missing from require_any_of. The three instance_id cases and the empty-payload case agree across languages, because the message declares ARGUMENT_READER_POSITIVE_ID with its own reader_message and require_any_of renders one sentence for both engines; the sibling fixtures say this text diverges, which was measured here and does not hold for this contract. The dry-run state body leaves engine version and replication type blank: TechDocs documents neither for Valkey.",
  "cases": [
    {
      "name": "updates a valkey instance label",
      "args": {
        "instance_id": 123,
        "label": "renamed-valkey",
        "confirm": true
      },
      "api_response": {
        "id": 123,
        "label": "renamed-valkey"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/databases/valkey/instances/123",
        "body": {
          "label": "renamed-valkey"
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "instance_id": 123,
        "label": "renamed-valkey"
      },
      "expect_error": "This updates a Valkey Managed Database instance. Set confirm=true to proceed."
    },
    {
      "name": "detaches the vpc on an explicit null private network",
      "args": {
        "instance_id": 123,
        "private_network": null,
        "confirm": true
      },
      "api_response": {
        "id": 123,
        "label": "renamed-valkey"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/databases/valkey/instances/123",
        "body": {
          "private_network": null
        }
      }
    },
    {
      "name": "zero-fills null and unknown response fields",
      "args": {
        "instance_id": 123,
        "label": "renamed-valkey",
        "confirm": true
      },
      "api_response": {
        "id": null,
        "label": null,
        "future_field": "ignored"
      },
      "expect_result": {
        "message": "Valkey Managed Database instance '' (ID: 0) updated",
        "database_instance": {
          "id": 0,
          "status": "",
          "label": "",
          "region": "",
          "type": "",
          "engine": "",
          "version": "",
          "cluster_size": 0,
          "replication_type": "",
          "ssl_connection": false,
          "encrypted": false,
          "allow_list": [],
          "created": "",
          "updated": ""
        }
      }
    },
    {
      "name": "rejects a bare-array API response",
      "args": {
        "instance_id": 123,
        "label": "renamed-valkey",
        "confirm": true
      },
      "api_response": [],
      "expect_api_error": "Failed to update Valkey Managed Database"
    },
    {
      "name": "dry run previews the update without sending it",
      "args": {
        "dry_run": true,
        "instance_id": 123,
        "label": "renamed-valkey"
      },
      "api_responses": {
        "GET /databases/valkey/instances/123": {
          "id": 123,
          "status": "active",
          "label": "prod-valkey",
          "region": "us-east",
          "type": "g6-dedicated-2",
          "engine": "valkey",
          "version": "",
          "cluster_size": 3,
          "replication_type": "",
          "ssl_connection": true,
          "encrypted": false,
          "allow_list": [
            "203.0.113.1/32"
          ],
          "created": "2026-01-02T03:04:05",
          "updated": "2026-01-03T04:05:06"
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_database_valkey_instance_update",
        "would_execute": {
          "method": "PUT",
          "path": "/databases/valkey/instances/123",
          "body": {
            "label": "renamed-valkey"
          }
        },
        "current_state": {
          "id": 123,
          "status": "active",
          "label": "prod-valkey",
          "region": "us-east",
          "type": "g6-dedicated-2",
          "engine": "valkey",
          "version": "",
          "cluster_size": 3,
          "replication_type": "",
          "ssl_connection": true,
          "encrypted": false,
          "allow_list": [
            "203.0.113.1/32"
          ],
          "created": "2026-01-02T03:04:05",
          "updated": "2026-01-03T04:05:06"
        },
        "dependencies": [],
        "side_effects": [
          "Valkey Managed Database 123 will be updated."
        ],
        "warnings": [
          "Updating a Managed Database can change service behavior."
        ]
      }
    },
    {
      "name": "resizes the cluster to three nodes",
      "args": {
        "instance_id": 123,
        "cluster_size": 3,
        "confirm": true
      },
      "api_response": {
        "id": 123,
        "label": "prod-valkey",
        "cluster_size": 3
      },
      "expect_request": {
        "method": "PUT",
        "path": "/databases/valkey/instances/123",
        "body": {
          "cluster_size": 3
        }
      }
    },
    {
      "name": "rejects a cluster size outside the documented set",
      "args": {
        "instance_id": 123,
        "cluster_size": 4,
        "confirm": true
      },
      "expect_error": "cluster_size must be one of: 1, 2, 3"
    },
    {
      "name": "sends the valkey-only region field",
      "args": {
        "instance_id": 123,
        "region": "us-west",
        "confirm": true
      },
      "api_response": {
        "id": 123,
        "label": "prod-valkey",
        "region": "us-west"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/databases/valkey/instances/123",
        "body": {
          "region": "us-west"
        }
      }
    },
    {
      "name": "refuses an argument the message does not declare",
      "args": {
        "instance_id": 123,
        "label": "renamed-valkey",
        "confirm": true,
        "bogus_field": "x"
      },
      "expect_error": "Unsupported argument(s) for linode_database_valkey_instance_update: bogus_field"
    },
    {
      "name": "rejects missing instance_id",
      "args": {
        "label": "renamed-valkey",
        "confirm": true
      },
      "expect_error": "instance_id must be a positive integer"
    },
    {
      "name": "rejects zero instance_id",
      "args": {
        "instance_id": 0,
        "label": "renamed-valkey",
        "confirm": true
      },
      "expect_error": "instance_id must be a positive integer"
    },
    {
      "name": "rejects non-integer instance_id",
      "args": {
        "instance_id": "123",
        "label": "renamed-valkey",
        "confirm": true
      },
      "expect_error": "instance_id must be a positive integer"
    },
    {
      "name": "rejects an empty update payload",
      "args": {
        "instance_id": 123,
        "confirm": true
      },
      "expect_error": "at least one update field must be provided"
    }
  ]
}
