{
  "tool": "linode_instance_migrate",
  "description": "Pins the migrate contract: the id rule it declares, the confirm gate, the POST it sends with and without a target region, the echo it answers with, and the preview reading the Linode whose region would change. The region echo carries no presence, so a caller who let Linode pick the destination reads it back empty.",
  "cases": [
    {
      "name": "rejects a linode_id below one",
      "args": {
        "linode_id": 0,
        "confirm": true
      },
      "expect_error": "linode_id must be a positive integer"
    },
    {
      "name": "requires confirm",
      "args": {
        "linode_id": 5,
        "region": "us-east"
      },
      "expect_error": "This migrates the instance and causes downtime during migration. Set confirm=true to proceed."
    },
    {
      "name": "migrates the instance to the region the call named",
      "args": {
        "linode_id": 5,
        "region": "us-east",
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/migrate",
        "body": {
          "region": "us-east"
        }
      }
    },
    {
      "name": "sends the placement group, the move type, and the upgrade flag",
      "args": {
        "linode_id": 5,
        "region": "us-east",
        "placement_group": {
          "id": 42,
          "compliant_only": true
        },
        "type": "warm",
        "upgrade": true,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/migrate",
        "body": {
          "region": "us-east",
          "placement_group": {
            "id": 42,
            "compliant_only": true
          },
          "type": "warm",
          "upgrade": true
        }
      }
    },
    {
      "name": "rejects a move type the route does not offer",
      "args": {
        "linode_id": 5,
        "type": "instant",
        "confirm": true
      },
      "expect_error": "type must be one of: cold, warm"
    },
    {
      "name": "migrates with no region, leaving the destination to Linode",
      "args": {
        "linode_id": 5,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/migrate",
        "body": {}
      }
    },
    {
      "name": "answers with the id and the region the call named",
      "args": {
        "linode_id": 5,
        "region": "us-east",
        "confirm": true
      },
      "api_response": {},
      "expect_result": {
        "message": "Migration initiated for instance 5",
        "linode_id": 5,
        "region": "us-east"
      }
    },
    {
      "name": "answers with an empty region when the call named none",
      "args": {
        "linode_id": 5,
        "confirm": true
      },
      "api_response": {},
      "expect_result": {
        "message": "Migration initiated for instance 5",
        "linode_id": 5,
        "region": ""
      }
    },
    {
      "name": "dry_run_preview",
      "args": {
        "linode_id": 5,
        "region": "us-west",
        "dry_run": true
      },
      "api_responses": {
        "GET /linode/instances/5": {
          "alerts": {
            "cpu": 0,
            "io": 0,
            "network_in": 0,
            "network_out": 0,
            "transfer_quota": 0
          },
          "backups": {
            "available": false,
            "enabled": false,
            "last_successful": null,
            "schedule": {
              "day": "",
              "window": ""
            }
          },
          "created": "",
          "group": "",
          "hypervisor": "",
          "id": 5,
          "image": "",
          "ipv4": [],
          "ipv6": "",
          "label": "web-1",
          "region": "us-east",
          "specs": {
            "disk": 0,
            "gpus": 0,
            "memory": 0,
            "transfer": 0,
            "vcpus": 0
          },
          "status": "running",
          "tags": [],
          "type": "g6-standard-1",
          "updated": "",
          "watchdog_enabled": false
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_instance_migrate",
        "would_execute": {
          "method": "POST",
          "path": "/linode/instances/5/migrate",
          "body": {
            "region": "us-west"
          }
        },
        "current_state": {
          "alerts": {
            "cpu": 0,
            "io": 0,
            "network_in": 0,
            "network_out": 0,
            "transfer_quota": 0
          },
          "backups": {
            "available": false,
            "enabled": false,
            "last_successful": null,
            "schedule": {
              "day": "",
              "window": ""
            }
          },
          "created": "",
          "group": "",
          "hypervisor": "",
          "id": 5,
          "image": "",
          "ipv4": [],
          "ipv6": "",
          "label": "web-1",
          "region": "us-east",
          "specs": {
            "disk": 0,
            "gpus": 0,
            "memory": 0,
            "transfer": 0,
            "vcpus": 0
          },
          "status": "running",
          "tags": [],
          "type": "g6-standard-1",
          "updated": "",
          "watchdog_enabled": false
        },
        "dependencies": [],
        "side_effects": [
          "Instance migrates from region us-east to us-west; it is unavailable during the migration."
        ],
        "warnings": []
      }
    }
  ]
}
