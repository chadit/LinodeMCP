          },
          "status": "offline",
          "tags": [],
          "type": "g6-standard-1",
          "updated": "",
          "watchdog_enabled": false
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_instance_boot",
        "would_execute": {
          "method": "POST",
          "path": "/linode/instances/5/boot",
