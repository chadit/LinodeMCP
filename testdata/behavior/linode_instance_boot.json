{
  "tool": "linode_instance_boot",
  "description": "Pins the power action: the id rule its contract declares, the confirm gate, the POST it sends with and without a configuration profile, the id echo it answers with, and the preview reading the instance whose power state would change.",
  "cases": [
    {
      "name": "rejects an instance_id below one",
      "args": {
        "instance_id": 0,
        "confirm": true
      },
      "expect_error": "instance_id must be a positive integer"
    },
    {
      "name": "rejects a config_id below one",
      "args": {
        "instance_id": 5,
        "config_id": 0,
        "confirm": true
      },
      "expect_error": "config_id must be a positive integer"
    },
    {
      "name": "requires confirm",
      "args": {
        "instance_id": 5
      },
      "expect_error": "This boots a Linode instance. Set confirm=true to proceed."
    },
    {
      "name": "boots the instance",
      "args": {
        "instance_id": 5,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/boot",
        "body": {}
      }
    },
    {
      "name": "boots with the configuration profile the call named",
      "args": {
        "instance_id": 5,
        "config_id": 77,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/5/boot",
        "body": {
          "config_id": 77
        }
      }
    },
    {
      "name": "answers with the id the call named",
      "args": {
        "instance_id": 5,
        "confirm": true
      },
      "api_response": {},
      "expect_result": {
        "message": "Instance 5 boot initiated successfully",
        "instance_id": 5
      }
    },
    {
      "name": "dry_run_preview",
      "args": {
        "instance_id": 5,
        "dry_run": true
      },
      "api_responses": {
        "GET /linode/instances/5": {
          "alerts": {
            "cpu": 0,
            "io": 0,
            "network_in": 0,
            "network_out": 0,
            "transfer_quota": 0
          },
