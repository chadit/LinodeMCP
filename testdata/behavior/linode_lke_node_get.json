{
  "tool": "linode_lke_node_get",
  "description": "Pins the cluster_id/node_id rejections (checked in order) and the single GET. cluster_id is an integer path param; node_id stays a string because LKE node ids are not numeric.",
  "cases": [
    {
      "name": "rejects missing cluster_id",
      "args": {},
      "expect_error": "cluster_id is required"
    },
    {
      "name": "rejects missing node_id",
      "args": {
        "cluster_id": 12345
      },
      "expect_error": "node_id is required"
    },
    {
      "name": "rejects a non-positive cluster_id",
      "args": {
        "cluster_id": 0
      },
      "expect_error": "cluster_id must be a positive integer"
    },
    {
      "name": "gets a node",
      "args": {
        "cluster_id": 12345,
        "node_id": "node-1"
      },
      "api_response": {
        "id": "node-1",
        "instance_id": 555,
        "status": "ready"
      },
      "expect_request": {
        "method": "GET",
        "path": "/lke/clusters/12345/nodes/node-1"
      }
    }
  ]
}
