{
  "tool": "linode_instance_config_interface_update",
  "description": "Pins the shared config_id/interface_id positive-int rejections and the config-interface update PUT body. Both languages now serve it from the proto contract, so the rejection cases carry confirm and one update field.",
  "cases": [
    {
      "name": "rejects non-positive config_id",
      "args": {
        "linode_id": 123,
        "config_id": 0,
        "interface_id": 9,
        "primary": true,
        "confirm": true
      },
      "expect_error": "config_id must be a positive integer"
    },
    {
      "name": "rejects non-positive interface_id",
      "args": {
        "linode_id": 123,
        "config_id": 7,
        "interface_id": 0,
        "primary": true,
        "confirm": true
      },
      "expect_error": "interface_id must be a positive integer"
    },
    {
      "name": "updates a config interface primary flag",
      "args": {
        "linode_id": 123,
        "config_id": 7,
        "interface_id": 9,
        "confirm": true,
        "primary": true
      },
      "api_response": {},
      "expect_request": {
        "method": "PUT",
        "path": "/linode/instances/123/configs/7/interfaces/9",
        "body": {
          "primary": true
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "linode_id": 123,
        "config_id": 7,
        "interface_id": 9,
        "primary": true
      },
      "expect_error": "This updates a network interface on the configuration profile. Set confirm=true to proceed."
    },
    {
      "name": "dry_run_preview",
      "args": {
        "linode_id": 123,
        "config_id": 7,
        "interface_id": 9,
        "primary": true,
        "dry_run": true
      },
      "api_responses": {
        "GET /linode/instances/123/configs/7/interfaces/9": {
          "active": false,
          "id": 0,
          "ipam_address": null,
          "ipv4": null,
          "label": null,
          "primary": false,
          "purpose": "",
          "subnet_id": null,
          "vpc_id": null
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_instance_config_interface_update",
        "would_execute": {
          "method": "PUT",
          "path": "/linode/instances/123/configs/7/interfaces/9",
          "body": {
            "primary": true
          }
        },
        "current_state": {
          "active": false,
          "id": 0,
          "ipam_address": null,
          "ipv4": null,
          "label": null,
          "primary": false,
          "purpose": "",
          "subnet_id": null,
          "vpc_id": null
        },
        "dependencies": [],
        "side_effects": [
          "Interface 9 on configuration profile 7 for Linode 123 will be updated."
        ],
        "warnings": []
      }
    }
  ]
}
