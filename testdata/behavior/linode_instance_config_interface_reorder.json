{
  "tool": "linode_instance_config_interface_reorder",
  "description": "Pins the config-interface reorder POST body and the duplicate-ids rejection both languages enforce. Both now serve it from the proto contract, so the rejection case carries confirm.",
  "cases": [
    {
      "name": "reorders config interfaces",
      "args": {
        "linode_id": 123,
        "config_id": 7,
        "confirm": true,
        "ids": [
          3,
          1,
          2
        ]
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/123/configs/7/interfaces/order",
        "body": {
          "ids": [
            3,
            1,
            2
          ]
        }
      }
    },
    {
      "name": "rejects duplicate interface ids",
      "args": {
        "linode_id": 123,
        "config_id": 7,
        "confirm": true,
        "ids": [
          1,
          1
        ]
      },
      "expect_error": "ids must not contain duplicate interface IDs"
    },
    {
      "name": "requires confirm",
      "args": {
        "linode_id": 123,
        "config_id": 7,
        "ids": [
          3,
          1,
          2
        ]
      },
      "expect_error": "This reorders network interfaces on the configuration profile. Set confirm=true to proceed."
    },
    {
      "name": "dry_run_preview",
      "args": {
        "linode_id": 123,
        "config_id": 7,
        "ids": [
          3,
          1,
          2
        ],
        "dry_run": true
      },
      "api_responses": {
        "GET /linode/instances/123/configs/7": {
          "id": 0,
          "label": ""
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_instance_config_interface_reorder",
        "would_execute": {
          "method": "POST",
          "path": "/linode/instances/123/configs/7/interfaces/order",
          "body": {
            "ids": [
              3,
              1,
              2
            ]
          }
        },
        "current_state": {
          "id": 0,
          "label": ""
        },
        "dependencies": [],
        "side_effects": [
          "Interfaces on configuration profile 7 for Linode 123 will be reordered."
        ],
        "warnings": []
      }
    }
  ]
}
