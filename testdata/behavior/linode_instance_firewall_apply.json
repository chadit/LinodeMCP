{
  "tool": "linode_instance_firewall_apply",
  "description": "Pins the linode_id rule its contract declares, the confirm gate, the bodyless POST, the id echo it answers with, and the preview, which now both reads the instance (Go's shape) and names the reassignment (Python's sentence).",
  "cases": [
    {
      "name": "rejects a linode_id below one",
      "args": {
        "linode_id": 0,
        "confirm": true
      },
      "expect_error": "linode_id must be a positive integer"
    },
    {
      "name": "requires confirm",
      "args": {
        "linode_id": 123
      },
      "expect_error": "This reapplies assigned firewalls to the Linode. Set confirm=true to proceed."
    },
    {
      "name": "reapplies firewalls with a plain POST",
      "args": {
        "linode_id": 123,
        "confirm": true
      },
      "api_response": {},
      "expect_request": {
        "method": "POST",
        "path": "/linode/instances/123/firewalls/apply"
      }
    },
    {
      "name": "answers with the id the call named",
      "args": {
        "linode_id": 123,
        "confirm": true
      },
      "api_response": {},
      "expect_result": {
        "message": "Firewall apply initiated for instance 123",
        "linode_id": 123
      }
    },
    {
      "name": "dry_run_preview",
      "args": {
        "linode_id": 123,
        "dry_run": true
      },
      "api_responses": {
