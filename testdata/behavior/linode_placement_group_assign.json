{
  "tool": "linode_placement_group_assign",
  "description": "Placement group assign: the assign POST once confirmed. Confirm-gate text, group_id validation text, and the linodes-array messages all diverge, so only the success path is pinned (see report). A success body that is not a JSON object must fail rather than turn into a zeroed placement-group record.",
  "cases": [
    {
      "name": "assigns Linodes to a placement group",
      "args": {
        "confirm": true,
        "group_id": 123,
        "linodes": [
          456,
          789
        ]
      },
      "api_response": {
        "id": 123,
        "label": "my-group"
      },
      "expect_request": {
        "method": "POST",
        "path": "/placement/groups/123/assign",
        "body": {
          "linodes": [
            456,
            789
          ]
        }
      }
    },
    {
      "name": "requires confirm",
      "args": {
        "group_id": 123,
        "linodes": [
          456,
          789
        ]
      },
      "expect_error": "This assigns Linodes to a placement group. Set confirm=true to proceed."
    },
    {
      "name": "rejects a numeric API response",
      "args": {
        "confirm": true,
        "group_id": 123,
        "linodes": [
          456,
          789
        ]
      },
      "api_response": 7,
      "expect_api_error": "Failed to assign Linodes to placement group"
    },
    {
      "name": "rejects a boolean API response",
      "args": {
        "confirm": true,
        "group_id": 123,
        "linodes": [
          456,
          789
        ]
      },
      "api_response": true,
      "expect_api_error": "Failed to assign Linodes to placement group"
    },
    {
      "name": "rejects a populated-array API response",
      "args": {
        "confirm": true,
        "group_id": 123,
        "linodes": [
          456,
          789
        ]
      },
      "api_response": [
        1,
        2
      ],
      "expect_api_error": "Failed to assign Linodes to placement group"
    },
    {
      "name": "dry_run_preview",
      "args": {
        "group_id": 123,
        "linodes": [
          456,
          789
        ],
        "dry_run": true
      },
      "api_responses": {
        "GET /placement/groups/123": {
          "id": 123,
          "label": "my-group",
          "region": "us-east",
          "placement_group_type": "",
          "placement_group_policy": "",
          "is_compliant": false,
          "members": []
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_placement_group_assign",
        "would_execute": {
          "method": "POST",
          "path": "/placement/groups/123/assign",
          "body": {
            "linodes": [
              456,
              789
            ]
          }
        },
        "current_state": {
          "id": 123,
          "label": "my-group",
          "region": "us-east",
          "placement_group_type": "",
          "placement_group_policy": "",
          "is_compliant": false,
          "members": []
        },
        "dependencies": [],
        "side_effects": [
          "Linode 456 will be assigned to placement group 123.",
          "Linode 789 will be assigned to placement group 123."
        ],
        "warnings": []
      }
    }
  ]
}
