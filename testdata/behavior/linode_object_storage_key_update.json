{
  "tool": "linode_object_storage_key_update",
  "description": "Pins the key_id rule (behind confirm), the regions replacement list, and the key update PUT body. bucket_access is documented only on the create route, so the input no longer declares it and a call that sends it puts nothing in the body. The confirm gate is asked ahead of validation, so the two confirm cases send no confirm at all and every other case carries confirm:true. A success body that is not a JSON object must fail rather than turn into a zeroed key record; the two languages word that failure differently, so only the key subject is shared.",
  "cases": [
    {
      "name": "requires positive key_id",
      "args": {
        "label": "renamed-key",
        "confirm": true
      },
      "expect_error": "key_id must be a positive integer"
    },
    {
      "name": "rejects a label longer than 50 characters",
      "args": {
        "key_id": 123,
        "label": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "confirm": true
      },
      "expect_error": "access key label must not exceed 50 characters"
    },
    {
      "name": "updates a key label",
      "args": {
        "key_id": 123,
        "label": "renamed-key",
        "confirm": true
      },
      "api_response": {
        "id": 123,
        "label": "renamed-key"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/object-storage/keys/123",
        "body": {
          "label": "renamed-key"
        }
      }
    },
    {
      "name": "requires confirm before a label change",
      "args": {
        "key_id": 123,
        "label": "renamed-key"
      },
      "expect_error": "This modifies an Object Storage access key: a label you send replaces the current one, and a regions list you send replaces the whole set. Leaving a region out drops it, or fails the call outright on a limited key. Set confirm=true to proceed."
    },
    {
      "name": "requires confirm before a regions replacement",
      "args": {
        "key_id": 7,
        "regions": [
          "us-east"
        ]
      },
      "expect_error": "This modifies an Object Storage access key: a label you send replaces the current one, and a regions list you send replaces the whole set. Leaving a region out drops it, or fails the call outright on a limited key. Set confirm=true to proceed."
    },
    {
      "name": "dry_run_preview",
      "args": {
        "key_id": 123,
        "label": "renamed-key",
        "dry_run": true
      },
      "api_responses": {
        "GET /object-storage/keys/123": {
          "id": 123,
          "label": "old-key",
          "access_key": "AK",
          "secret_key": "",
          "limited": false,
          "bucket_access": [],
          "regions": []
        }
      },
      "expect_result": {
        "dry_run": true,
        "tool": "linode_object_storage_key_update",
        "would_execute": {
          "method": "PUT",
          "path": "/object-storage/keys/123",
          "body": {
            "label": "renamed-key"
          }
        },
        "current_state": {
          "id": 123,
          "label": "old-key",
          "access_key": "AK",
          "secret_key": "",
          "limited": false,
          "bucket_access": [],
          "regions": []
        },
        "dependencies": [],
        "side_effects": [
          "Label changes from \"old-key\" to \"renamed-key\"."
        ],
        "warnings": []
      }
    },
    {
      "name": "rejects a numeric API response",
      "args": {
        "key_id": 123,
        "label": "renamed-key",
        "confirm": true
      },
      "api_response": 7,
      "expect_api_error": "access key 123"
    },
    {
      "name": "rejects a boolean API response",
      "args": {
        "key_id": 123,
        "label": "renamed-key",
        "confirm": true
      },
      "api_response": true,
      "expect_api_error": "access key 123"
    },
    {
      "name": "rejects a populated-array API response",
      "args": {
        "key_id": 123,
        "label": "renamed-key",
        "confirm": true
      },
      "api_response": [
        1,
        2
      ],
      "expect_api_error": "access key 123"
    },
    {
      "name": "carries regions into the body",
      "args": {
        "key_id": 7,
        "confirm": true,
        "regions": [
          "us-east",
          "us-west"
        ]
      },
      "api_response": {
        "id": 7,
        "label": "key"
      },
      "expect_request": {
        "method": "PUT",
        "path": "/object-storage/keys/7",
        "body": {
          "regions": [
            "us-east",
            "us-west"
          ]
        }
      }
    },
    {
      "name": "rejects a regions value that is not an array of strings",
      "args": {
        "key_id": 7,
        "confirm": true,
        "regions": [
          5
        ]
      },
      "expect_error": "regions must be an array of strings"
    },
    {
      "name": "refuses a bucket_access argument, which the route documents only on create",
      "args": {
        "key_id": 123,
        "label": "renamed-key",
        "confirm": true,
        "bucket_access": [
          {
            "bucket_name": "my-bucket",
            "region": "us-east",
            "permissions": "read_write"
          }
        ]
      },
      "expect_error": "Unsupported argument(s) for linode_object_storage_key_update: bucket_access"
    }
  ]
}
